---
import Layout from "../layouts/Layout.astro";
import { url } from "../utils/url";
---

<Layout
  title="Página no encontrada | Quintanamur S.L."
  description="Esta página no existe. Vuelve al inicio para ver nuestros servicios de maquinaria agrícola y obra civil en Yecla, Murcia."
  activePage=""
>
  <!-- Sección principal 404 -->
  <section
    class="relative min-h-[calc(100dvh-5rem)] flex items-center justify-center overflow-hidden py-20 px-margin-mobile md:px-margin-desktop"
    aria-labelledby="error-404-heading"
  >
    <!-- Fondo con vídeo difuminado (mismo asset que el hero de portada) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <video
        class="w-full h-full object-cover opacity-20 blur-sm scale-105"
        src={url("/images/home/hero-home-dust.mp4")}
        autoplay
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      ></video>
      <!-- Overlay degradado para legibilidad -->
      <div class="absolute inset-0 bg-gradient-to-b from-surface/80 via-surface/70 to-surface/95 pointer-events-none"></div>
    </div>

    <!-- Contenido centrado -->
    <div class="relative z-10 max-w-2xl mx-auto text-center">

      <!-- Código 404 como elemento gráfico tipográfico -->
      <div class="relative inline-block mb-6 select-none" aria-hidden="true">
        <span class="block font-extrabold text-[120px] sm:text-[160px] md:text-[200px] leading-none text-secondary/15">
          404
        </span>
        <span class="absolute inset-0 flex items-center justify-center font-extrabold text-[120px] sm:text-[160px] md:text-[200px] leading-none text-secondary/40 blur-[2px]">
          404
        </span>
      </div>

      <!-- Encabezado -->
      <h1
        id="error-404-heading"
        class="font-headline-lg text-headline-lg text-on-surface font-bold mb-4 -mt-8 sm:-mt-12"
      >
        Esta página no existe
      </h1>

      <!-- Descripción -->
      <p class="text-on-surface-variant text-body-lg leading-relaxed mb-10 max-w-lg mx-auto">
        Es posible que la URL haya cambiado o que hayas seguido un enlace desactualizado.
        Usa los botones de abajo para volver a terreno conocido.
      </p>

      <!-- Separador visual con la paleta de marca -->
      <div class="flex items-center justify-center gap-2 mb-10">
        <div class="h-px w-16 bg-secondary/30"></div>
        <div class="w-2 h-2 rounded-full bg-secondary"></div>
        <div class="h-px w-16 bg-secondary/30"></div>
      </div>

      <!-- Botones de rescate -->
      <nav aria-label="Opciones de navegación alternativas" class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={url("/")}
          class="btn-agricola text-center"
          id="btn-404-inicio"
        >
          ← Volver al Inicio
        </a>
        <a
          href={url("/servicios")}
          class="btn-obra text-center"
          id="btn-404-servicios"
        >
          Ver Nuestros Servicios
        </a>
        <a
          href={url("/contacto")}
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded border-2 border-secondary text-secondary hover:bg-secondary hover:text-on-secondary transition-all font-label-caps text-label-caps uppercase tracking-wider font-semibold"
          id="btn-404-contacto"
        >
          Solicitar Presupuesto
        </a>
      </nav>

      <!-- Info de contacto rápido -->
      <p class="mt-12 text-sm text-on-surface-variant">
        ¿Necesitas ayuda? Escríbenos a
        <a
          href="mailto:centralquintanamur@gmail.com"
          class="text-secondary hover:text-secondary-fixed-dim underline underline-offset-2 transition-colors focus:outline-none focus:ring-2 focus:ring-secondary rounded"
        >
          centralquintanamur@gmail.com
        </a>
      </p>

    </div>
  </section>
</Layout>
