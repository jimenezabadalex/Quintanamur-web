---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Catálogo de Servicios - Quintanamur S.L."
  description="Servicios agrícolas de precisión y obra civil pesada: despedregado, plantación GPS, desfonde, excavaciones y movimientos de tierra en Murcia y comarca."
  activePage="servicios"
>
  <!-- Header / Hero Section idéntico a Maquinaria -->
  <header
    class="bg-inverse-surface text-on-primary py-24 md:py-32 px-margin-mobile md:px-margin-desktop relative overflow-hidden"
  >
    <!-- Background Layers -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Fondo Agrícola -->
      <div
        id="hero-bg-agricola"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-100"
        style="background-image: url('/images/servicios/hero-agricola-bg.webp');"
      >
      </div>

      <!-- Fondo Obra Civil y Excavaciones (Original completo en lienzo panorámico) -->
      <div
        id="hero-bg-obra-civil"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-0"
        style="background-image: url('/images/servicios/hero-obra-civil-bg.webp');"
      >
      </div>

      <!-- Gradient overlay idéntico a Maquinaria: tono oscuro sólido en el lado del texto, abierto en el lado de la maquinaria -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-inverse-surface via-inverse-surface/85 to-inverse-surface/40 md:to-transparent"
      >
      </div>
    </div>

    <div
      class="max-w-max-width mx-auto relative z-10 flex flex-col md:flex-row items-center"
    >
      <div class="w-full md:w-8/12 lg:w-7/12">
        <span
          class="font-label-caps text-label-caps text-secondary-fixed-dim uppercase tracking-widest block mb-4"
        >
          Especialistas en Movimiento de Tierras y Campo
        </span>
        <h1
          class="font-display-lg text-headline-lg-mobile md:text-display-lg text-surface-bright mb-6 leading-tight"
        >
          Nuestro Catálogo de Servicios
        </h1>
        <p
          class="font-headline-md text-headline-md font-medium text-surface-container-high mb-4"
        >
          De la preparación de parcelas agrícolas al movimiento de tierras más
          pesado.
        </p>
        <p
          class="font-body-lg text-body-lg text-surface-container mb-10 max-w-2xl leading-relaxed"
        >
          En Quintanamur S.L. centralizamos todas las fases de tu proyecto con
          maquinaria propia de última generación. Elige tu sector para descubrir
          cómo podemos ayudarte.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            id="btn-nav-agricola"
            class="inline-flex items-center justify-center bg-primary text-on-primary font-body-md font-bold py-3.5 px-6 rounded hover:bg-primary-container transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary-fixed sharp-shadow group"
            href="#servicios-agricolas"
          >
            <span
              class="material-symbols-outlined mr-2 group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
            VER SERVICIOS AGRÍCOLAS
          </a>
          <a
            id="btn-nav-obra-civil"
            class="inline-flex items-center justify-center bg-secondary text-on-secondary font-body-md font-bold py-3.5 px-6 rounded hover:bg-secondary-container hover:text-on-secondary-container transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-secondary-fixed sharp-shadow group"
            href="#obra-civil"
          >
            <span
              class="material-symbols-outlined mr-2 group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
            VER OBRA CIVIL Y EXCAVACIONES
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Section 1: SERVICIOS AGRÍCOLAS -->
  <section
    class="bg-surface py-24 px-margin-mobile md:px-margin-desktop"
    id="servicios-agricolas"
  >
    <div class="max-w-max-width mx-auto">
      <div class="mb-16">
        <span
          class="font-label-caps text-label-caps text-primary tracking-widest uppercase mb-2 block"
          >Sector Primario</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          SERVICIOS AGRÍCOLAS
        </h2>
        <div class="w-24 h-1 bg-primary mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-gutter">
        <!-- Service Card 1 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Fresadora FI-IVAN y tractor Fendt triturando piedra"
              src="/images/servicios/despedregado-trituracion.webp"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase"
            >
              Preparación de Suelo
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Despedregado de Fincas y Trituración de Piedra
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Transformamos terrenos pedregosos en tierras fértiles y seguras
              para la siembra. Nuestra maquinaria especializada tritura roca in
              situ hasta 35cm de profundidad, mejorando la estructura del suelo
              sin necesidad de retirar material.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >precision_manufacturing</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Tecnología empleada</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Fresadora FI-IVAN + Tractor Fendt Alta Potencia</span
                >
              </div>
            </div>
            <a
              href="/contacto"
              class="w-full bg-primary text-on-primary font-body-md font-bold py-3 px-4 rounded hover:bg-primary-container transition-colors duration-200 mt-auto flex justify-center items-center text-center"
            >
              Solicitar presupuesto para triturar piedra
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Plantadora con guiado satelital GPS"
              src="/images/servicios/plantacion-gps-vinedo.webp"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase"
            >
              Plantación de Precisión
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Plantación con GPS para Viñedo, Olivar y Frutales
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Plantación automatizada guiada por satélite GPS Topcon para todo
              tipo de marcos de plantación: viñedo, olivar, almendro, pistacho,
              higuera y frutales. Máxima precisión en alineación y colocación de
              tutores en una sola pasada.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >satellite_alt</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Tecnología empleada</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Plantadora TOPCOM con autoguiado GPS</span
                >
              </div>
            </div>
            <a
              href="/contacto"
              class="w-full bg-primary text-on-primary font-body-md font-bold py-3 px-4 rounded hover:bg-primary-container transition-colors duration-200 mt-auto flex justify-center items-center text-center"
            >
              Consultar disponibilidad de plantación
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Bento grid for smaller services -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
        <!-- Service 3 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg p-8 sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-start justify-between mb-4">
              <h3
                class="font-headline-md text-headline-md text-on-surface max-w-[80%]"
              >
                Desfonde de Tierras y Arado Profunda
              </h3>
              <div class="bg-surface-container-high p-2 rounded-full">
                <span class="material-symbols-outlined text-primary"
                  >landscape</span
                >
              </div>
            </div>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
            >
              Aireación y rotura de capas compactadas profundas para mejorar el
              drenaje y desarrollo radicular previo a nuevas plantaciones.
            </p>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-6">
              <span class="material-symbols-outlined text-outline text-sm"
                >build</span
              >
              <span
                class="font-label-caps text-label-caps text-on-surface-variant uppercase"
                >Arado de volteo profundo</span
              >
            </div>
            <a
              href="/contacto"
              class="text-primary font-body-md font-bold flex items-center hover:text-primary-container transition-colors"
            >
              Hablar con un especialista en desfonde
              <span class="material-symbols-outlined ml-1 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Service 4 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg p-8 sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-start justify-between mb-4">
              <h3
                class="font-headline-md text-headline-md text-on-surface max-w-[80%]"
              >
                Arranque de Viña y Limpieza de Cultivos
              </h3>
              <div class="bg-surface-container-high p-2 rounded-full">
                <span class="material-symbols-outlined text-primary"
                  >forest</span
                >
              </div>
            </div>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
            >
              Eliminación eficiente de plantaciones viejas o enfermas,
              incluyendo la extracción de raíces y preparación inicial del
              terreno para su próximo uso.
            </p>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-6">
              <span class="material-symbols-outlined text-outline text-sm"
                >build</span
              >
              <span
                class="font-label-caps text-label-caps text-on-surface-variant uppercase"
                >Topo + Pala extractora</span
              >
            </div>
            <a
              href="/contacto"
              class="text-primary font-body-md font-bold flex items-center hover:text-primary-container transition-colors"
            >
              Pedir precio por hectárea para arranque
              <span class="material-symbols-outlined ml-1 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: OBRA CIVIL Y EXCAVACIONES -->
  <section
    class="bg-surface-variant py-24 px-margin-mobile md:px-margin-desktop border-t border-outline-variant/20"
    id="obra-civil"
  >
    <div class="max-w-max-width mx-auto">
      <div class="mb-16">
        <span
          class="font-label-caps text-label-caps text-secondary tracking-widest uppercase mb-2 block"
          >Infraestructura &amp; Construcción</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          OBRA CIVIL Y EXCAVACIONES
        </h2>
        <div class="w-24 h-1 bg-secondary mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
        <!-- Service Card 1: Excavaciones y Movimiento de Tierras -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-60 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Excavación y movimiento de tierras con retropala"
              src="/images/servicios/excavaciones-movimiento.webp"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-secondary text-on-secondary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase shadow-sm"
            >
              Movimiento de Tierras
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Excavaciones, Cimentaciones y Movimiento de Tierras
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Ejecución precisa de excavaciones para cimentaciones profundas,
              zanjas para canalizaciones y grandes movimientos de tierra para
              preparación de plataformas y nivelaciones topográficas.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >engineering</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Equipo Principal</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Retropala TrinityB 432</span
                >
              </div>
            </div>
            <a
              href="/contacto"
              class="w-full border-2 border-secondary text-secondary font-body-md font-bold py-3 px-4 rounded hover:bg-secondary hover:text-on-secondary transition-colors duration-200 mt-auto flex justify-center items-center text-center"
            >
              Consultar servicios de excavación
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Service Card 2: Arreglo y Trituración de Caminos Rurales -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-60 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Arreglo y trituración de caminos rurales con fresadora"
              src="/images/servicios/trituracion-reciclaje.webp"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-secondary text-on-secondary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase shadow-sm"
            >
              Restauración de Caminos
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Arreglo y Trituración de Caminos Rurales
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Acondicionamiento y recuperación de caminos de tierra mediante la
              trituración directa de piedras in situ. Convertimos los firmes
              pedregosos y degradados en superficies lisas y transitables de una
              sola pasada, sin necesidad de retirar escombros.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >precision_manufacturing</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Equipo Principal</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Fresadora FI-IVAN 2T S2 + Fendt</span
                >
              </div>
            </div>
            <a
              href="/contacto"
              class="w-full border-2 border-secondary text-secondary font-body-md font-bold py-3 px-4 rounded hover:bg-secondary hover:text-on-secondary transition-colors duration-200 mt-auto flex justify-center items-center text-center"
            >
              Solicitar Arreglo Camino
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Service Card 3: Trituración de Arbolado y Desbroce Integral -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-60 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Trituración de arbolado y desbroce integral"
              src="/images/servicios/desbroce-forestal.webp"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-secondary text-on-secondary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase shadow-sm"
            >
              Desbroce Pesado
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Trituración de Arbolado y Desbroce Integral
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Limpieza profunda de parcelas forestales o urbanizables,
              eliminando arbolado y maleza densa con equipos de alta capacidad.
              Acondicionamiento para infraestructuras y proyectos solares.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >forest</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Equipo Principal</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Trituradora Forestal TFT Cancela</span
                >
              </div>
            </div>
            <a
              href="/contacto"
              class="w-full border-2 border-secondary text-secondary font-body-md font-bold py-3 px-4 rounded hover:bg-secondary hover:text-on-secondary transition-colors duration-200 mt-auto flex justify-center items-center text-center"
            >
              Solicitar Desbroce y Trituración
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-20 px-margin-mobile md:px-margin-desktop bg-surface">
    <div
      class="max-w-4xl mx-auto bg-primary-container rounded-xl p-8 md:p-12 sharp-shadow text-center relative overflow-hidden"
    >
      <div
        class="absolute inset-0 opacity-10 pointer-events-none flex"
        style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, #ffffff 10px, #ffffff 20px);"
      >
      </div>
      <div class="relative z-10">
        <span
          class="material-symbols-outlined text-5xl text-on-primary-container mb-4 block"
          >handshake</span
        >
        <h2
          class="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-primary-container mb-4"
        >
          ¿Tienes un proyecto en mente?
        </h2>
        <p
          class="font-body-lg text-body-lg text-on-primary-container/90 mb-8 max-w-2xl mx-auto leading-relaxed"
        >
          Evaluamos tu terreno y te ofrecemos la solución técnica más eficiente
          con maquinaria propia, garantizando plazos y resultados profesionales.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="tel:+34600000000"
            class="bg-on-primary-container text-primary-container font-body-md font-bold py-4 px-8 rounded hover:bg-surface transition-colors duration-200 flex items-center justify-center shadow-md sharp-shadow"
          >
            <span class="material-symbols-outlined mr-2">call</span>
            Llamar al Teléfono Directo
          </a>
          <a
            href="https://wa.me/34600000000"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-transparent border-2 border-on-primary-container text-on-primary-container font-body-md font-bold py-4 px-8 rounded hover:bg-on-primary-container/10 transition-colors duration-200 flex items-center justify-center"
          >
            <span class="material-symbols-outlined mr-2">chat</span>
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    function setupHeaderPreview() {
      const btnAgricola = document.getElementById("btn-nav-agricola");
      const btnObraCivil = document.getElementById("btn-nav-obra-civil");

      const bgAgricola = document.getElementById("hero-bg-agricola");
      const bgObraCivil = document.getElementById("hero-bg-obra-civil");

      function showAgricola() {
        if (bgAgricola && bgObraCivil) {
          bgAgricola.classList.remove("opacity-0");
          bgAgricola.classList.add("opacity-100");
          bgObraCivil.classList.remove("opacity-100");
          bgObraCivil.classList.add("opacity-0");
        }
      }

      function showObraCivil() {
        if (bgAgricola && bgObraCivil) {
          bgAgricola.classList.remove("opacity-100");
          bgAgricola.classList.add("opacity-0");
          bgObraCivil.classList.remove("opacity-0");
          bgObraCivil.classList.add("opacity-100");
        }
      }

      btnAgricola?.addEventListener("mouseenter", showAgricola);
      btnAgricola?.addEventListener("focus", showAgricola);
      btnAgricola?.addEventListener("touchstart", showAgricola, {
        passive: true,
      });

      btnObraCivil?.addEventListener("mouseenter", showObraCivil);
      btnObraCivil?.addEventListener("focus", showObraCivil);
      btnObraCivil?.addEventListener("touchstart", showObraCivil, {
        passive: true,
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupHeaderPreview);
    } else {
      setupHeaderPreview();
    }
    document.addEventListener("astro:page-load", setupHeaderPreview);
  </script>
</Layout>
