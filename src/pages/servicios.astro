---
import Layout from "../layouts/Layout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { url } from "../utils/url";
---

<Layout
  title="Servicios Agrícolas y Movimiento de Tierras | Quintanamur"
  description="Servicios agrícolas, arranque de cultivos despedregado, plantación GPS, desfonde y excavaciones para obra civil en Yecla y comarca. "
  activePage="servicios"
>
  <!-- Header / Hero Section idéntico a Maquinaria -->
  <header
    class="bg-inverse-surface text-on-primary py-24 md:py-32 px-margin-mobile md:px-margin-desktop relative overflow-hidden"
  >
    <!-- Background Layers -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Fondo Agrícola -->
      <div
        id="hero-bg-agricola"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-100"
        style={`background-image: url('${url("/images/servicios/agricola/hero-agricola-bg.webp")}');`}
      >
      </div>

      <!-- Fondo Obra Civil y Excavaciones (Original completo en lienzo panorámico) -->
      <div
        id="hero-bg-obra-civil"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-0"
        style={`background-image: url('${url("/images/servicios/obra-civil/hero-obra-civil-bg.webp")}');`}
      >
      </div>

      <!-- Gradient overlay idéntico a Maquinaria: tono oscuro sólido en el lado del texto, abierto en el lado de la maquinaria -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-inverse-surface via-inverse-surface/85 to-inverse-surface/40 md:to-transparent"
      >
      </div>
    </div>

    <div
      class="max-w-max-width mx-auto relative z-10 flex flex-col md:flex-row items-center"
    >
      <div class="w-full md:w-8/12 lg:w-7/12">
        <span
          class="font-label-caps text-label-caps text-secondary-fixed-dim uppercase tracking-widest block mb-4"
        >
          Especialistas en Movimiento de Tierras y Campo
        </span>
        <h1
          class="font-display-lg text-headline-lg-mobile md:text-display-lg lg:text-[60px] font-extrabold mb-5 text-on-primary leading-tight"
        >
          CATÁLOGO DE SERVICIOS<br />
          <span class="text-primary-fixed-dim">AGRÍCOLAS Y OBRA CIVIL</span>
        </h1>
        <p
          class="font-headline-md text-headline-md font-medium text-inverse-on-surface mb-3"
        >
          De la preparación de parcelas agrícolas al movimiento de tierras más
          pesado.
        </p>
        <p
          class="font-body-lg text-body-lg md:text-[19px] text-inverse-on-surface/90 mb-8 max-w-xl leading-relaxed"
        >
          En Quintanamur S.L. centralizamos todas las fases de tu proyecto con
          maquinaria propia de última generación. Elige tu sector para descubrir
          cómo podemos ayudarte.
        </p>
        <div class="hidden md:flex flex-row gap-4">
          <a
            id="btn-nav-agricola"
            class="btn-agricola group"
            href="#servicios-agricolas"
          >
            <span
              class="material-symbols-outlined mr-2 group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
            VER SERVICIOS AGRÍCOLAS
          </a>
          <a id="btn-nav-obra-civil" class="btn-obra group" href="#obra-civil">
            <span
              class="material-symbols-outlined mr-2 group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
            VER OBRA CIVIL Y EXCAVACIONES
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Quick-Jump Category Bar (Solo Móvil) -->
  <div
    class="sticky top-20 z-30 md:hidden bg-surface/95 backdrop-blur-md px-3 py-2.5"
  >
    <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
      <a
        href="#servicios-agricolas"
        class="flex items-center justify-center gap-1.5 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-primary/50 dark:border-primary/70 text-primary font-bold py-2.5 px-3 rounded-lg text-center shadow-[2px_2px_0px_#61993b] dark:shadow-[2px_2px_0px_#78b54e] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">agriculture</span>
        <span class="font-label-caps text-xs font-bold tracking-tight">Agrícolas</span>
        <span class="material-symbols-outlined text-xs opacity-70">arrow_downward</span>
      </a>
      <a
        href="#obra-civil"
        class="flex items-center justify-center gap-1.5 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-secondary/50 dark:border-secondary/70 text-secondary font-bold py-2.5 px-3 rounded-lg text-center shadow-[2px_2px_0px_#b58753] dark:shadow-[2px_2px_0px_#d4a36b] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">construction</span>
        <span class="font-label-caps text-xs font-bold tracking-tight">Excavaciones</span>
        <span class="material-symbols-outlined text-xs opacity-70">arrow_downward</span>
      </a>
    </div>
  </div>

  <!-- Section 1: SERVICIOS AGRÍCOLAS -->
  <section
    class="bg-surface py-24 px-margin-mobile md:px-margin-desktop scroll-mt-36"
    id="servicios-agricolas"
  >
    <div class="max-w-max-width mx-auto">
      <div class="mb-16">
        <span
          class="font-label-caps text-label-caps text-primary tracking-widest uppercase mb-2 block"
          >Sector Primario</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          SERVICIOS AGRÍCOLAS DE PRECISIÓN
        </h2>
        <div class="w-24 h-1 bg-primary mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-gutter">
        <!-- Service Card 1 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Fresadora de piedra FI-IVAN y tractor Fendt triturando roca en parcela"
              src={url("/images/servicios/agricola/despedregado-trituracion.webp")}
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase"
            >
              Preparación de Suelo
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Despedregado de Fincas y Trituración de Piedra
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Transformamos terrenos pedregosos en tierras fértiles y seguras
              para la siembra. Nuestra maquinaria especializada tritura roca in
              situ hasta 35cm de profundidad, mejorando la estructura del suelo
              sin necesidad de retirar material.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >precision_manufacturing</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Maquinaria empleada</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Fresadora FI-IVAN + Tractor Fendt Alta Potencia</span
                >
              </div>
            </div>
            <a href={url("/contacto")} class="btn-agricola w-full mt-auto">
              <span>Solicitar presupuesto para triturar piedra</span>
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div
          class="bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col group"
        >
          <div class="h-64 overflow-hidden relative">
            <img
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              alt="Plantadora guiada por satélite GPS Topcon realizando plantación de viña"
              src={url("/images/servicios/agricola/plantacion-gps-vinedo.webp")}
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"
            >
            </div>
            <div
              class="absolute bottom-4 left-4 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 rounded-full uppercase"
            >
              Plantación de Precisión
            </div>
          </div>
          <div class="p-8 flex flex-col flex-grow">
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Plantación con GPS para Viñedo y Frutales
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 flex-grow leading-relaxed"
            >
              Plantación automatizada guiada por satélite GPS Topcon para todo
              tipo de marcos de plantación: viñedo, olivar, almendro, pistacho,
              higuera y frutales. Máxima precisión en alineación y colocación de
              tutores en una sola pasada.
            </p>
            <div
              class="bg-surface-container p-4 rounded-md mb-6 border border-outline-variant/20 flex items-center"
            >
              <span
                class="material-symbols-outlined text-secondary mr-3 text-2xl"
                >satellite_alt</span
              >
              <div>
                <span
                  class="font-label-caps text-label-caps text-secondary uppercase block mb-1"
                  >Maquinaria empleada</span
                >
                <span
                  class="font-body-md text-body-md font-medium text-on-surface"
                  >Plantadora TOPCOM con autoguiado GPS</span
                >
              </div>
            </div>
            <a href={url("/contacto")} class="btn-agricola w-full mt-auto">
              <span>Consultar disponibilidad de plantación</span>
              <span class="material-symbols-outlined ml-2 text-sm"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Service 3: Desfonde de Tierras y Arado Profundo -->
      <div
        class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-6 sm:p-8 sharp-shadow hover:sharp-shadow-hover transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8"
      >
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-2">
            <div
              class="bg-primary/10 text-primary p-2.5 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="material-symbols-outlined text-2xl">landscape</span>
            </div>
            <h3 class="font-headline-md text-[22px] font-bold text-on-surface">
              Desfonde de Tierras y Arado Profundo
            </h3>
          </div>
          <p
            class="font-body-md text-body-md text-on-surface-variant leading-relaxed pl-0 md:pl-12"
          >
            Aireación y rotura de capas compactadas profundas para mejorar el
            drenaje y desarrollo radicular previo a nuevas plantaciones.
          </p>
        </div>
        <div
          class="flex flex-col sm:flex-row md:flex-col lg:flex-row items-start sm:items-center gap-4 flex-shrink-0"
        >
          <div
            class="bg-surface-container px-4 py-2.5 rounded-md border border-outline-variant/20 flex items-center gap-2.5"
          >
            <span class="material-symbols-outlined text-secondary text-xl"
              >agriculture</span
            >
            <div>
              <span
                class="font-label-caps text-[10px] text-secondary uppercase block"
                >Maquinaria</span
              >
              <span class="font-body-md text-sm font-medium text-on-surface"
                >Arado de volteo profundo</span
              >
            </div>
          </div>
          <a
            href={url("/contacto")}
            class="btn-agricola whitespace-nowrap w-full sm:w-auto"
          >
            <span>Consultar desfonde</span>
            <span class="material-symbols-outlined ml-1.5 text-sm"
              >arrow_forward</span
            >
          </a>
        </div>
      </div>

      <!-- Service 4: Arranque de Viña y Limpieza de Cultivos (Showcase Multimedia Panorámico) -->
      <div
        id="showcase-arranque"
        class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all duration-300 grid grid-cols-1 lg:grid-cols-12"
      >
        <!-- Columna Izquierda: Pantalla del Reproductor Secuencial Multimedia (lg:col-span-7) -->
        <div
          class="lg:col-span-7 bg-neutral-950 relative overflow-hidden flex flex-col justify-between min-h-[380px] sm:min-h-[460px] lg:min-h-[520px]"
        >
          <!-- Contenedor de Diapositivas (Aspecto adaptable y centrado) -->
          <div
            id="arranque-slides-container"
            class="relative w-full h-full flex-grow flex items-center justify-center bg-black overflow-hidden"
          >
            <!-- Diapositiva 0: Imagen - Cultivo antes del arranque -->
            <div
              class="arranque-slide absolute inset-0 transition-opacity duration-700 opacity-100 flex items-center justify-center"
              data-type="image"
              data-duration="4500"
              data-badge="Paso 1: Parcela Inicial"
              data-title="Cultivo antes del arranque"
            >
              <img
                src={url("/images/servicios/agricola/arranque/cultivo-antes-arranque.webp")}
                alt="Parcela con viñedo y cultivo viejo antes del arranque"
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>

            <!-- Diapositiva 1: Imagen - Tractor en labor de arranque -->
            <div
              class="arranque-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none flex items-center justify-center"
              data-type="image"
              data-duration="4500"
              data-badge="Paso 2: Equipo de Tiro"
              data-title="Tractor con apero extractor y pala"
            >
              <img
                src={url("/images/servicios/agricola/arranque/tractor-aranque-cultivos.webp")}
                alt="Tractor John Deere 7710 equipado para arranque de cepas"
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>

            <!-- Diapositiva 2: Vídeo - Tractor arrancando cultivo -->
            <div
              class="arranque-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none flex items-center justify-center"
              data-type="video"
              data-badge="Paso 3: Arranque en Acción (Vídeo)"
              data-title="Extracción y descepado profundo de raíz"
            >
              <video
                src={url("/images/servicios/agricola/arranque/tractor-arranque-cultivo.mp4")}
                class="w-full h-full object-contain"
                muted
                playsinline
                preload="metadata"
              ></video>
            </div>

            <!-- Diapositiva 3: Vídeo - Recogida y despeje de cultivos -->
            <div
              class="arranque-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none flex items-center justify-center"
              data-type="video"
              data-badge="Paso 4: Recogida y Despeje (Vídeo)"
              data-title="Recolección mecánica y acopio de restos"
            >
              <video
                src={url("/images/servicios/agricola/arranque/recogida-aranque-cultivos.mp4")}
                class="w-full h-full object-contain"
                muted
                playsinline
                preload="metadata"
              ></video>
            </div>

            <!-- Diapositiva 4: Imagen - Cultivo después del arranque -->
            <div
              class="arranque-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none flex items-center justify-center"
              data-type="image"
              data-duration="4500"
              data-badge="Paso 5: Finca Limpia y Lista"
              data-title="Terreno acondicionado y nivelado"
            >
              <img
                src={url("/images/servicios/agricola/arranque/cultivo-despues-arranque.webp")}
                alt="Finca agrícola limpia, despejada y lista para nueva siembra tras el arranque"
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Capa Superior: Badge dinámico y controles de audio/pausa -->
          <div
            class="absolute top-4 left-4 right-4 z-20 flex items-center justify-between pointer-events-none"
          >
            <span
              id="arranque-badge"
              class="bg-black/75 backdrop-blur-md text-white font-label-caps text-xs px-3.5 py-1.5 rounded-full border border-white/20 shadow-lg flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              <span id="arranque-badge-text">Paso 1: Parcela Inicial</span>
            </span>

            <div class="flex items-center gap-2 pointer-events-auto">
              <!-- Botón Silencio / Sonido -->
              <button
                id="arranque-btn-sound"
                type="button"
                class="w-9 h-9 rounded-full bg-black/70 hover:bg-black/90 backdrop-blur-md text-white border border-white/20 flex items-center justify-center shadow-lg transition-all active:scale-95 cursor-pointer"
                title="Activar/Silenciar sonido de vídeos"
                aria-label="Activar o silenciar sonido"
              >
                <span class="material-symbols-outlined text-lg" id="arranque-sound-icon">volume_off</span>
              </button>
              <!-- Botón Pausa / Play -->
              <button
                id="arranque-btn-play"
                type="button"
                class="w-9 h-9 rounded-full bg-black/70 hover:bg-black/90 backdrop-blur-md text-white border border-white/20 flex items-center justify-center shadow-lg transition-all active:scale-95 cursor-pointer"
                title="Pausar o reanudar reproducción automática"
                aria-label="Pausar o reanudar"
              >
                <span class="material-symbols-outlined text-lg" id="arranque-play-icon">pause</span>
              </button>
            </div>
          </div>

          <!-- Capa Inferior: Flechas de navegación y Barra de Progreso -->
          <div
            class="absolute bottom-0 inset-x-0 z-20 bg-gradient-to-t from-black/85 via-black/40 to-transparent p-4 pt-8"
          >
            <div class="flex items-center justify-between mb-2.5">
              <button
                id="arranque-btn-prev"
                type="button"
                class="px-3 py-1 rounded bg-white/15 hover:bg-white/30 text-white text-xs font-label-caps flex items-center gap-1 transition-all cursor-pointer select-none"
                title="Paso anterior"
              >
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                <span>ANTERIOR</span>
              </button>
              <span
                id="arranque-counter"
                class="text-white/80 font-label-caps text-[11px] tracking-widest font-semibold"
                >1 / 5</span
              >
              <button
                id="arranque-btn-next"
                type="button"
                class="px-3 py-1 rounded bg-white/15 hover:bg-white/30 text-white text-xs font-label-caps flex items-center gap-1 transition-all cursor-pointer select-none"
                title="Siguiente paso"
              >
                <span>SIGUIENTE</span>
                <span class="material-symbols-outlined text-sm">arrow_forward</span>
              </button>
            </div>
            <!-- Barra de Progreso Continua -->
            <div class="w-full h-1.5 bg-white/20 rounded-full overflow-hidden">
              <div
                id="arranque-progress-bar"
                class="h-full bg-primary rounded-full transition-all duration-100 ease-linear"
                style="width: 0%;"
              >
              </div>
            </div>
          </div>
        </div>

        <!-- Columna Derecha: Información Técnica y Pasos Interactivos (lg:col-span-5) -->
        <div
          class="lg:col-span-5 p-6 sm:p-8 lg:p-10 flex flex-col justify-between h-full bg-surface-container-lowest border-t lg:border-t-0 lg:border-l border-outline-variant/20"
        >
          <div>
            <div
              class="inline-flex items-center gap-2 mb-3 text-primary font-label-caps text-label-caps font-bold"
            >
              <span class="material-symbols-outlined text-base">video_library</span>
              <span>PROCESO REAL EN CAMPO</span>
            </div>
            <h3
              class="font-headline-md text-[24px] md:text-[28px] font-bold text-on-surface mb-3 leading-tight"
            >
              Arranque de Viña y Limpieza de Cultivos
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
            >
              Eliminación integral y mecanizada de plantaciones leñosas, viñedos
              viejos y arbolado improductivo. Arrancamos de raíz el sistema
              radicular, acopiamos el ramaje y dejamos la parcela completamente
              despejada y allanada para su próxima siembra o reestructuración.
            </p>

            <!-- Lista interactiva de los 5 pasos del proceso -->
            <div class="space-y-2 mb-6" id="arranque-step-tabs">
              <button
                type="button"
                class="arranque-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-primary/10 border-primary/40 text-on-surface font-semibold shadow-2xs"
                data-step="0"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-5 h-5 rounded-full bg-primary text-on-primary text-[10px] font-bold flex items-center justify-center flex-shrink-0">1</span>
                  <span class="text-xs truncate">Estado Inicial: Parcela con viñedo</span>
                </div>
                <span class="material-symbols-outlined text-sm text-primary flex-shrink-0">yard</span>
              </button>

              <button
                type="button"
                class="arranque-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-surface border-outline-variant/30 text-on-surface-variant hover:border-primary/40"
                data-step="1"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-5 h-5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold flex items-center justify-center flex-shrink-0">2</span>
                  <span class="text-xs truncate">Equipo de Tiro: Tractor John Deere</span>
                </div>
                <span class="material-symbols-outlined text-sm text-outline flex-shrink-0">agriculture</span>
              </button>

              <button
                type="button"
                class="arranque-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-surface border-outline-variant/30 text-on-surface-variant hover:border-primary/40"
                data-step="2"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-5 h-5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold flex items-center justify-center flex-shrink-0">3</span>
                  <span class="text-xs truncate">Arranque Profundo de Raíz <strong class="text-primary font-bold">(Vídeo)</strong></span>
                </div>
                <span class="material-symbols-outlined text-sm text-primary flex-shrink-0">play_circle</span>
              </button>

              <button
                type="button"
