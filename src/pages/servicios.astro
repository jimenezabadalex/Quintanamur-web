---
import Layout from "../layouts/Layout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import ServiceAccordionItem from "../components/ServiceAccordionItem.astro";
import { SERVICIOS } from "../data/servicios";
import { url } from "../utils/url";

const serviciosAgricolas = SERVICIOS.filter((s) => s.categoria === "agricola");
const serviciosObraCivil = SERVICIOS.filter((s) => s.categoria === "obra-civil");
---

<Layout
  title="Servicios Agrícolas y Movimiento de Tierras | Quintanamur"
  description="Servicios agrícolas, arranque de cultivos despedregado, plantación GPS, desfonde y excavaciones para obra civil en Yecla y comarca. "
  activePage="servicios"
>
  <!-- Header / Hero Section idéntico a Maquinaria -->
  <header
    class="bg-inverse-surface text-on-primary py-24 md:py-32 px-margin-mobile md:px-margin-desktop relative overflow-hidden"
  >
    <!-- Background Layers -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Fondo Agrícola -->
      <div
        id="hero-bg-agricola"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-100"
        style={`background-image: url('${url("/images/servicios/agricola/hero-agricola-bg.webp")}');`}
      >
      </div>

      <!-- Fondo Obra Civil y Excavaciones (Original completo en lienzo panorámico) -->
      <div
        id="hero-bg-obra-civil"
        class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-opacity duration-700 ease-in-out opacity-0"
        style={`background-image: url('${url("/images/servicios/obra-civil/hero-obra-civil-bg.webp")}');`}
      >
      </div>

      <!-- Gradient overlay idéntico a Maquinaria: tono oscuro sólido en el lado del texto, abierto en el lado de la maquinaria -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-inverse-surface via-inverse-surface/85 to-inverse-surface/40 md:to-transparent"
      >
      </div>
    </div>

    <div
      class="max-w-max-width mx-auto relative z-10 flex flex-col md:flex-row items-center"
    >
      <div class="w-full md:w-8/12 lg:w-7/12">
        <h1
          class="font-display-lg text-headline-lg-mobile md:text-display-lg lg:text-[60px] font-extrabold mb-6 sm:mb-8 text-on-primary leading-[1.16] sm:leading-[1.18]"
        >
          CATÁLOGO DE SERVICIOS<br />
          <span class="text-primary-fixed-dim">AGRÍCOLAS Y OBRA CIVIL</span>
        </h1>
        <p
          class="font-headline-md text-lg sm:text-xl md:text-2xl font-semibold text-inverse-on-surface mb-5 sm:mb-6 leading-snug"
        >
          De la preparación de parcelas agrícolas al movimiento de tierras más
          pesado.
        </p>
        <p
          class="font-body-lg text-body-lg sm:text-[18px] md:text-[19px] text-inverse-on-surface/90 mb-8 sm:mb-10 max-w-2xl leading-relaxed"
        >
          En Quintanamur S.L. centralizamos todas las fases de tu proyecto con
          maquinaria propia de última generación. Elige tu sector para descubrir
          cómo podemos ayudarte.
        </p>
        <div class="hidden md:flex flex-row gap-4 sm:gap-5 pt-1">
          <a
            id="btn-nav-agricola"
            class="btn-agricola group"
            href="#servicios-agricolas"
          >
            <span
              class="material-symbols-outlined mr-2 group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
            VER SERVICIOS AGRÍCOLAS
          </a>
          <a id="btn-nav-obra-civil" class="btn-obra group" href="#obra-civil">
            <span
              class="material-symbols-outlined mr-2 group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
            VER OBRA CIVIL Y EXCAVACIONES
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Quick-Jump Category Bar (Solo Móvil) -->
  <div
    class="sticky top-20 z-30 md:hidden bg-surface/95 backdrop-blur-md px-3 py-2.5"
  >
    <div class="grid grid-cols-2 gap-3 max-w-md mx-auto">
      <a
        href="#servicios-agricolas"
        class="flex items-center justify-center gap-1.5 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-primary/50 dark:border-primary/70 text-primary font-bold py-2.5 px-3 rounded-lg text-center shadow-[2px_2px_0px_#61993b] dark:shadow-[2px_2px_0px_#78b54e] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">agriculture</span>
        <span class="font-label-caps text-xs font-bold tracking-tight">Agrícolas</span>
        <span class="material-symbols-outlined text-xs opacity-70">arrow_downward</span>
      </a>
      <a
        href="#obra-civil"
        class="flex items-center justify-center gap-1.5 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-secondary/50 dark:border-secondary/70 text-secondary font-bold py-2.5 px-3 rounded-lg text-center shadow-[2px_2px_0px_#b58753] dark:shadow-[2px_2px_0px_#d4a36b] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">construction</span>
        <span class="font-label-caps text-xs font-bold tracking-tight">Excavaciones</span>
        <span class="material-symbols-outlined text-xs opacity-70">arrow_downward</span>
      </a>
    </div>
  </div>

  <!-- Section 1: SERVICIOS AGRÍCOLAS -->
  <section
    class="bg-surface py-24 px-margin-mobile md:px-margin-desktop scroll-mt-36"
    id="servicios-agricolas"
  >
    <div class="max-w-max-width mx-auto">
      <div class="mb-16">
        <span
          class="font-label-caps text-label-caps text-primary tracking-widest uppercase mb-2 block"
          >Sector Primario</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          SERVICIOS AGRÍCOLAS DE PRECISIÓN
        </h2>
        <div class="w-24 h-1 bg-primary mt-4"></div>
      </div>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-2xl">
        Listado de intervenciones agrícolas de precisión. Selecciona cualquier servicio para desplegar su demostración multimedia, detalles técnicos y fases en campo.
      </p>

      <!-- Listado Acordeón Agrícola -->
      <div class="space-y-3" id="accordion-group-agricola">
        {serviciosAgricolas.map((servicio) => (
          <ServiceAccordionItem servicio={servicio} />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: OBRA CIVIL Y EXCAVACIONES -->
  <section
    class="bg-surface-variant py-24 px-margin-mobile md:px-margin-desktop border-t border-outline-variant/20 scroll-mt-36"
    id="obra-civil"
  >
    <div class="max-w-max-width mx-auto">
      <div class="mb-8">
        <span
          class="font-label-caps text-label-caps text-secondary tracking-widest uppercase mb-2 block"
          >Infraestructura &amp; Construcción</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          OBRA CIVIL Y EXCAVACIONES
        </h2>
        <div class="w-24 h-1 bg-secondary mt-4"></div>
      </div>

      <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-2xl">
        Soluciones integrales de excavación pesada, preparación de plataformas y acondicionamiento de caminos. Haz clic en un servicio para ver su proceso y maquinaria.
      </p>

      <!-- Listado Acordeón Obra Civil -->
      <div class="space-y-3" id="accordion-group-obra-civil">
        {serviciosObraCivil.map((servicio) => (
          <ServiceAccordionItem servicio={servicio} />
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <CtaBanner
    title="¿Tienes un proyecto en mente?"
    description="Evaluamos tu terreno y te ofrecemos la solución técnica más eficiente con maquinaria propia, garantizando plazos y resultados profesionales."
  />

  <script>
    function setupHeaderPreview() {
      const btnAgricola = document.getElementById("btn-nav-agricola");
      const btnObraCivil = document.getElementById("btn-nav-obra-civil");

      const bgAgricola = document.getElementById("hero-bg-agricola");
      const bgObraCivil = document.getElementById("hero-bg-obra-civil");

      function showAgricola() {
        if (bgAgricola && bgObraCivil) {
          bgAgricola.classList.remove("opacity-0");
          bgAgricola.classList.add("opacity-100");
          bgObraCivil.classList.remove("opacity-100");
          bgObraCivil.classList.add("opacity-0");
        }
      }

      function showObraCivil() {
        if (bgAgricola && bgObraCivil) {
          bgAgricola.classList.remove("opacity-100");
          bgAgricola.classList.add("opacity-0");
          bgObraCivil.classList.remove("opacity-0");
          bgObraCivil.classList.add("opacity-100");
        }
      }

      btnAgricola?.addEventListener("mouseenter", showAgricola);
      btnAgricola?.addEventListener("focus", showAgricola);
      btnAgricola?.addEventListener("touchstart", showAgricola, {
        passive: true,
      });

      btnObraCivil?.addEventListener("mouseenter", showObraCivil);
      btnObraCivil?.addEventListener("focus", showObraCivil);
      btnObraCivil?.addEventListener("touchstart", showObraCivil, {
        passive: true,
      });
    }

    let accordionCleanup: (() => void) | null = null;

    function setupServicesAccordion() {
      if (accordionCleanup) {
        accordionCleanup();
        accordionCleanup = null;
      }

      const items = document.querySelectorAll<HTMLElement>(".service-accordion-item");
      if (!items.length) return;

      const playerControllers = new Map<
        string,
        {
          play: () => void;
          pause: () => void;
          reset: () => void;
          destroy: () => void;
        }
      >();

      items.forEach((item) => {
        const serviceId = item.getAttribute("data-service-id") || "";
        const isAgricola = item.getAttribute("data-category") === "agricola";
        const showcase = item.querySelector<HTMLElement>(".service-showcase-container");
        if (!showcase) return;

        const slides = showcase.querySelectorAll<HTMLElement>(".service-slide");
        const stepTabs = showcase.querySelectorAll<HTMLElement>(".service-step-btn");
        const progressBar = showcase.querySelector<HTMLElement>(".service-progress-bar");
        const badgeText = showcase.querySelector<HTMLElement>(".service-badge-text");
        const counter = showcase.querySelector<HTMLElement>(".service-counter");
        const btnPrev = showcase.querySelector<HTMLElement>(".service-btn-prev");
        const btnNext = showcase.querySelector<HTMLElement>(".service-btn-next");
        const btnPlay = showcase.querySelector<HTMLElement>(".service-btn-play");
        const playIcon = showcase.querySelector<HTMLElement>(".service-play-icon");
        const btnSound = showcase.querySelector<HTMLElement>(".service-btn-sound");
        const soundIcon = showcase.querySelector<HTMLElement>(".service-sound-icon");

        let currentIndex = 0;
        let isPlaying = false;
        let isMuted = true;
        let cycleCount = 0;
        const maxCycles = 1;
        let currentRaf: number | null = null;
        let imageTimerStart = 0;
        let imageElapsedBeforePause = 0;
        let currentDuration = 4500;
        let isDestroyed = false;

        function stopCurrentMedia() {
          if (currentRaf) {
            cancelAnimationFrame(currentRaf);
            currentRaf = null;
          }
          slides.forEach((s) => {
            const v = s.querySelector<HTMLVideoElement>("video");
            if (v) {
              v.pause();
              v.currentTime = 0;
            }
          });
        }

        function updateStepTabs(index: number) {
          stepTabs.forEach((tab, i) => {
            const numBadge = tab.querySelector<HTMLElement>(".step-num-badge");
            const videoBadge = tab.querySelector<HTMLElement>(".step-video-badge");

            if (i === index) {
              tab.className = isAgricola
                ? "service-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-primary/10 border-primary/40 text-on-surface font-semibold shadow-2xs"
                : "service-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-secondary/10 border-secondary/40 text-on-surface font-semibold shadow-2xs";
              if (numBadge) {
                numBadge.className = isAgricola
                  ? "step-num-badge w-5 h-5 rounded-full text-[10px] font-bold flex items-center justify-center flex-shrink-0 bg-primary text-on-primary"
                  : "step-num-badge w-5 h-5 rounded-full text-[10px] font-bold flex items-center justify-center flex-shrink-0 bg-secondary text-on-secondary";
              }
              if (videoBadge) {
                videoBadge.className = isAgricola
                  ? "step-video-badge text-[10px] font-label-caps font-bold px-1.5 py-0.5 rounded border flex-shrink-0 bg-primary/20 text-primary border-primary/30"
                  : "step-video-badge text-[10px] font-label-caps font-bold px-1.5 py-0.5 rounded border flex-shrink-0 bg-secondary/20 text-secondary border-secondary/30";
              }
            } else {
              tab.className =
                "service-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-surface border-outline-variant/30 text-on-surface-variant hover:border-outline";
              if (numBadge) {
                numBadge.className =
                  "step-num-badge w-5 h-5 rounded-full text-[10px] font-bold flex items-center justify-center flex-shrink-0 bg-surface-container-high text-on-surface-variant";
              }
              if (videoBadge) {
                videoBadge.className =
                  "step-video-badge text-[10px] font-label-caps font-bold px-1.5 py-0.5 rounded border flex-shrink-0 bg-surface-container text-on-surface-variant border-outline-variant/30";
              }
            }
          });
        }

        function onSlideCompleted() {
          if (currentIndex === slides.length - 1) {
            cycleCount++;
            if (cycleCount >= maxCycles) {
              // Fin de ciclo completo: pausar y poner icono replay
              isPlaying = false;
              if (playIcon) playIcon.textContent = "replay";
              if (btnPlay) btnPlay.setAttribute("title", "Volver a reproducir secuencia");
              if (progressBar) progressBar.style.width = "100%";
              return;
            }
          }
          goToSlide(currentIndex + 1);
        }

        function goToSlide(index: number, manual = false) {
          if (isDestroyed) return;
          stopCurrentMedia();

          currentIndex = (index + slides.length) % slides.length;
          const currentSlide = slides[currentIndex];
          if (!currentSlide) return;

          const isVideo = currentSlide.getAttribute("data-type") === "video";
          currentDuration = parseInt(currentSlide.getAttribute("data-duration") || "4500", 10);
          imageElapsedBeforePause = 0;

          slides.forEach((slide, i) => {
            if (i === currentIndex) {
              slide.classList.remove("opacity-0", "pointer-events-none");
              slide.classList.add("opacity-100", "pointer-events-auto");
            } else {
              slide.classList.remove("opacity-100", "pointer-events-auto");
              slide.classList.add("opacity-0", "pointer-events-none");
            }
          });

          if (badgeText) {
            badgeText.textContent = currentSlide.getAttribute("data-badge") || `Paso ${currentIndex + 1}`;
          }
          if (counter) {
            counter.textContent = `${currentIndex + 1} / ${slides.length}`;
          }
          if (progressBar) {
            progressBar.style.width = "0%";
          }

          updateStepTabs(currentIndex);

          if (manual && isPlaying && playIcon) {
            playIcon.textContent = "pause";
          }

          if (!isPlaying) return;

          if (isVideo) {
            const video = currentSlide.querySelector<HTMLVideoElement>("video");
            if (video) {
              video.muted = isMuted;
              video.currentTime = 0;
              const playPromise = video.play();
              if (playPromise !== undefined) {
                playPromise.catch(() => {
                  video.muted = true;
                  video.play().catch(() => {});
                });
              }
            }
          } else {
            startImageTimer();
          }
        }

        function startImageTimer() {
          if (!isPlaying || isDestroyed) return;
          imageTimerStart = performance.now() - imageElapsedBeforePause;

          function tick(now: number) {
            if (!isPlaying || isDestroyed) return;
            const elapsed = now - imageTimerStart;
            const pct = Math.min(100, (elapsed / currentDuration) * 100);
            if (progressBar) {
              progressBar.style.width = `${pct}%`;
            }

            if (elapsed >= currentDuration) {
              onSlideCompleted();
            } else {
              currentRaf = requestAnimationFrame(tick);
            }
          }

          currentRaf = requestAnimationFrame(tick);
        }

        slides.forEach((slide) => {
          const video = slide.querySelector<HTMLVideoElement>("video");
          if (video) {
            video.addEventListener("timeupdate", () => {
              if (slides[currentIndex] === slide && video.duration > 0 && progressBar) {
                const pct = (video.currentTime / video.duration) * 100;
                progressBar.style.width = `${pct}%`;
              }
            });

            video.addEventListener("ended", () => {
              if (slides[currentIndex] === slide && isPlaying) {
                onSlideCompleted();
              }
            });
          }
        });

        btnPrev?.addEventListener("click", () => goToSlide(currentIndex - 1, true));
        btnNext?.addEventListener("click", () => goToSlide(currentIndex + 1, true));

        stepTabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const idx = parseInt(tab.getAttribute("data-step-index") || "0", 10);
            goToSlide(idx, true);
          });
        });

        btnPlay?.addEventListener("click", () => {
          if (playIcon?.textContent === "replay") {
            cycleCount = 0;
            isPlaying = true;
            playIcon.textContent = "pause";
            btnPlay.setAttribute("title", "Pausar reproducción");
            goToSlide(0);
            return;
          }

          isPlaying = !isPlaying;
          if (playIcon) {
            playIcon.textContent = isPlaying ? "pause" : "play_arrow";
          }
          btnPlay.setAttribute("title", isPlaying ? "Pausar reproducción" : "Reanudar reproducción");

          const currentSlide = slides[currentIndex];
          const isVideo = currentSlide?.getAttribute("data-type") === "video";

          if (isPlaying) {
            if (isVideo) {
              const video = currentSlide.querySelector<HTMLVideoElement>("video");
              video?.play().catch(() => {});
            } else {
              startImageTimer();
            }
          } else {
            if (isVideo) {
              const video = currentSlide.querySelector<HTMLVideoElement>("video");
              video?.pause();
            } else {
              if (currentRaf) {
                cancelAnimationFrame(currentRaf);
                currentRaf = null;
              }
              imageElapsedBeforePause = performance.now() - imageTimerStart;
            }
          }
        });

        btnSound?.addEventListener("click", () => {
          isMuted = !isMuted;
          slides.forEach((s) => {
            const v = s.querySelector<HTMLVideoElement>("video");
            if (v) v.muted = isMuted;
          });
          if (soundIcon) {
            soundIcon.textContent = isMuted ? "volume_off" : "volume_up";
          }
          btnSound.setAttribute("title", isMuted ? "Activar sonido" : "Silenciar sonido");
        });

        playerControllers.set(serviceId, {
          play: () => {
            cycleCount = 0;
            isPlaying = true;
            if (playIcon) playIcon.textContent = "pause";
            goToSlide(0);
          },
          pause: () => {
            isPlaying = false;
            stopCurrentMedia();
            if (playIcon) playIcon.textContent = "play_arrow";
          },
          reset: () => {
            cycleCount = 0;
            isPlaying = false;
            stopCurrentMedia();
            if (progressBar) progressBar.style.width = "0%";
            if (playIcon) playIcon.textContent = "play_arrow";
            goToSlide(0);
          },
          destroy: () => {
            isDestroyed = true;
            stopCurrentMedia();
          },
        });
      });

      function closeItem(item: HTMLElement) {
        const serviceId = item.getAttribute("data-service-id") || "";
        const trigger = item.querySelector<HTMLElement>(".service-accordion-trigger");
        const collapse = item.querySelector<HTMLElement>(".service-accordion-collapse");
        const chevron = item.querySelector<HTMLElement>(".accordion-chevron");
        const actionPill = item.querySelector<HTMLElement>(".accordion-action-pill");
        const actionText = item.querySelector<HTMLElement>(".accordion-action-text");

        item.setAttribute("data-state", "closed");
        trigger?.setAttribute("aria-expanded", "false");
        collapse?.classList.remove("grid-rows-[1fr]");
        collapse?.classList.add("grid-rows-[0fr]");
        chevron?.classList.remove("rotate-180");
        if (actionText) actionText.textContent = "Ver demostración";
        if (actionPill) {
          actionPill.className =
            "accordion-action-pill flex items-center gap-1.5 px-3.5 py-2 rounded-lg font-label-caps text-xs font-bold border transition-all bg-surface-container-high text-on-surface border-outline-variant/30 hover:border-outline";
        }

        const controller = playerControllers.get(serviceId);
        controller?.pause();
      }

      function openItem(item: HTMLElement) {
        items.forEach((other) => {
          if (other !== item && other.getAttribute("data-state") === "open") {
            closeItem(other);
          }
        });

        const serviceId = item.getAttribute("data-service-id") || "";
        const trigger = item.querySelector<HTMLElement>(".service-accordion-trigger");
        const collapse = item.querySelector<HTMLElement>(".service-accordion-collapse");
        const chevron = item.querySelector<HTMLElement>(".accordion-chevron");
        const actionPill = item.querySelector<HTMLElement>(".accordion-action-pill");
        const actionText = item.querySelector<HTMLElement>(".accordion-action-text");
        const isAgricola = item.getAttribute("data-category") === "agricola";

        item.setAttribute("data-state", "open");
        trigger?.setAttribute("aria-expanded", "true");
        collapse?.classList.remove("grid-rows-[0fr]");
        collapse?.classList.add("grid-rows-[1fr]");
        chevron?.classList.add("rotate-180");
        if (actionText) actionText.textContent = "Plegar servicio";
        if (actionPill) {
          actionPill.className = isAgricola
            ? "accordion-action-pill flex items-center gap-1.5 px-3.5 py-2 rounded-lg font-label-caps text-xs font-bold border transition-all bg-primary text-on-primary border-primary"
            : "accordion-action-pill flex items-center gap-1.5 px-3.5 py-2 rounded-lg font-label-caps text-xs font-bold border transition-all bg-secondary text-on-secondary border-secondary";
        }

        const controller = playerControllers.get(serviceId);
        controller?.play();

        setTimeout(() => {
          const rect = item.getBoundingClientRect();
          if (rect.top < 80 || rect.top > window.innerHeight - 150) {
            item.scrollIntoView({ behavior: "smooth", block: "nearest" });
          }
        }, 150);
      }

      items.forEach((item) => {
        const trigger = item.querySelector<HTMLElement>(".service-accordion-trigger");
        trigger?.addEventListener("click", () => {
          const isOpen = item.getAttribute("data-state") === "open";
          if (isOpen) {
            closeItem(item);
          } else {
            openItem(item);
          }
        });
      });

      accordionCleanup = () => {
        playerControllers.forEach((ctrl) => ctrl.destroy());
        playerControllers.clear();
      };
    }

    function initPage() {
      setupHeaderPreview();
      setupServicesAccordion();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPage);
    } else {
      initPage();
    }
    document.addEventListener("astro:page-load", initPage);
  </script>
</Layout>
