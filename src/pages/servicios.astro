  <script>
    function setupHeaderPreview() {
      const btnAgricola = document.getElementById("btn-nav-agricola");
      const btnObraCivil = document.getElementById("btn-nav-obra-civil");

      const bgAgricola = document.getElementById("hero-bg-agricola");
      const bgObraCivil = document.getElementById("hero-bg-obra-civil");

      function showAgricola() {
        if (bgAgricola && bgObraCivil) {
          bgAgricola.classList.remove("opacity-0");
          bgAgricola.classList.add("opacity-100");
          bgObraCivil.classList.remove("opacity-100");
          bgObraCivil.classList.add("opacity-0");
        }
      }

      function showObraCivil() {
        if (bgAgricola && bgObraCivil) {
          bgAgricola.classList.remove("opacity-100");
          bgAgricola.classList.add("opacity-0");
          bgObraCivil.classList.remove("opacity-0");
          bgObraCivil.classList.add("opacity-100");
        }
      }

      btnAgricola?.addEventListener("mouseenter", showAgricola);
      btnAgricola?.addEventListener("focus", showAgricola);
      btnAgricola?.addEventListener("touchstart", showAgricola, {
        passive: true,
      });

      btnObraCivil?.addEventListener("mouseenter", showObraCivil);
      btnObraCivil?.addEventListener("focus", showObraCivil);
      btnObraCivil?.addEventListener("touchstart", showObraCivil, {
        passive: true,
      });
    }

    let arranqueCleanup: (() => void) | null = null;

    function setupArranquePlayer() {
      if (arranqueCleanup) {
        arranqueCleanup();
        arranqueCleanup = null;
      }

      const container = document.getElementById("showcase-arranque");
      if (!container) return;

      const slides = container.querySelectorAll<HTMLElement>(".arranque-slide");
      const stepTabs = container.querySelectorAll<HTMLElement>(".arranque-step-btn");
      const progressBar = document.getElementById("arranque-progress-bar");
      const badgeText = document.getElementById("arranque-badge-text");
      const counter = document.getElementById("arranque-counter");
      const btnPrev = document.getElementById("arranque-btn-prev");
      const btnNext = document.getElementById("arranque-btn-next");
      const btnPlay = document.getElementById("arranque-btn-play");
      const playIcon = document.getElementById("arranque-play-icon");
      const btnSound = document.getElementById("arranque-btn-sound");
      const soundIcon = document.getElementById("arranque-sound-icon");

      if (!slides.length) return;

      let currentIndex = 0;
      let isPlaying = true;
      let isMuted = true;
      let currentRaf: number | null = null;
      let imageTimerStart = 0;
      let imageElapsedBeforePause = 0;
      let currentDuration = 4500;
      let isDestroyed = false;

      // Pausa cualquier vídeo activo
      function stopCurrentMedia() {
        if (currentRaf) {
          cancelAnimationFrame(currentRaf);
          currentRaf = null;
        }
        slides.forEach((s) => {
          const v = s.querySelector("video");
          if (v) {
            v.pause();
            v.currentTime = 0;
          }
        });
      }

      function updateTabs(index: number) {
        stepTabs.forEach((tab, i) => {
          const numBadge = tab.querySelector("span:first-child");
          const icon = tab.querySelector(".material-symbols-outlined");

          if (i === index) {
            tab.className =
              "arranque-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-primary/10 border-primary/40 text-on-surface font-semibold shadow-2xs";
            if (numBadge) {
              numBadge.className =
                "w-5 h-5 rounded-full bg-primary text-on-primary text-[10px] font-bold flex items-center justify-center flex-shrink-0";
            }
            if (icon) {
              icon.classList.remove("text-outline");
              icon.classList.add("text-primary");
            }
          } else {
            tab.className =
              "arranque-step-btn w-full text-left p-2.5 rounded-lg border transition-all flex items-center justify-between gap-3 cursor-pointer bg-surface border-outline-variant/30 text-on-surface-variant hover:border-primary/40";
            if (numBadge) {
              numBadge.className =
                "w-5 h-5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-bold flex items-center justify-center flex-shrink-0";
            }
            if (icon) {
              icon.classList.remove("text-primary");
              icon.classList.add("text-outline");
            }
          }
        });
      }

      function goToSlide(index: number, manual = false) {
        if (isDestroyed) return;
        stopCurrentMedia();

        currentIndex = (index + slides.length) % slides.length;
        const currentSlide = slides[currentIndex];
        const isVideo = currentSlide.getAttribute("data-type") === "video";
        currentDuration = parseInt(currentSlide.getAttribute("data-duration") || "4500", 10);
        imageElapsedBeforePause = 0;

        // Actualizar visibilidad de slides
        slides.forEach((slide, i) => {
          if (i === currentIndex) {
            slide.classList.remove("opacity-0", "pointer-events-none");
            slide.classList.add("opacity-100", "pointer-events-auto");
          } else {
            slide.classList.remove("opacity-100", "pointer-events-auto");
            slide.classList.add("opacity-0", "pointer-events-none");
          }
        });

        // Actualizar textos e indicadores
        if (badgeText) {
          badgeText.textContent = currentSlide.getAttribute("data-badge") || `Paso ${currentIndex + 1}`;
        }
        if (counter) {
          counter.textContent = `${currentIndex + 1} / ${slides.length}`;
        }
        if (progressBar) {
          progressBar.style.width = "0%";
        }

        updateTabs(currentIndex);

        if (!isPlaying) return;

        if (isVideo) {
          const video = currentSlide.querySelector("video");
          if (video) {
            video.muted = isMuted;
            video.currentTime = 0;
            const playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(() => {
                // Silenciar e intentar de nuevo si el navegador bloqueó audio
                video.muted = true;
                video.play().catch(() => {});
              });
            }
          }
        } else {
          startImageTimer();
        }
      }

      function startImageTimer() {
        if (!isPlaying || isDestroyed) return;
        imageTimerStart = performance.now() - imageElapsedBeforePause;

        function tick(now: number) {
          if (!isPlaying || isDestroyed) return;
          const elapsed = now - imageTimerStart;
          const pct = Math.min(100, (elapsed / currentDuration) * 100);
          if (progressBar) {
            progressBar.style.width = `${pct}%`;
          }

          if (elapsed >= currentDuration) {
            goToSlide(currentIndex + 1);
          } else {
            currentRaf = requestAnimationFrame(tick);
          }
        }

        currentRaf = requestAnimationFrame(tick);
      }

      // Eventos en vídeos (actualizar barra y pasar al siguiente al finalizar)
      slides.forEach((slide) => {
        const video = slide.querySelector("video");
        if (video) {
          video.addEventListener("timeupdate", () => {
            if (slides[currentIndex] === slide && video.duration > 0 && progressBar) {
              const pct = (video.currentTime / video.duration) * 100;
              progressBar.style.width = `${pct}%`;
            }
          });

          video.addEventListener("ended", () => {
            if (slides[currentIndex] === slide && isPlaying) {
              goToSlide(currentIndex + 1);
            }
          });
        }
      });

      // Controles manuales
      btnPrev?.addEventListener("click", () => goToSlide(currentIndex - 1, true));
      btnNext?.addEventListener("click", () => goToSlide(currentIndex + 1, true));

      stepTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const stepIndex = parseInt(tab.getAttribute("data-step") || "0", 10);
          goToSlide(stepIndex, true);
        });
      });

      // Play / Pausa
      btnPlay?.addEventListener("click", () => {
        isPlaying = !isPlaying;
        if (playIcon) {
          playIcon.textContent = isPlaying ? "pause" : "play_arrow";
        }
        btnPlay.setAttribute("title", isPlaying ? "Pausar reproducción automática" : "Reanudar reproducción");

        const currentSlide = slides[currentIndex];
        const isVideo = currentSlide.getAttribute("data-type") === "video";

        if (isPlaying) {
          if (isVideo) {
            const video = currentSlide.querySelector("video");
            video?.play().catch(() => {});
          } else {
            startImageTimer();
          }
        } else {
          if (isVideo) {
            const video = currentSlide.querySelector("video");
            video?.pause();
          } else {
            if (currentRaf) {
              cancelAnimationFrame(currentRaf);
              currentRaf = null;
            }
            imageElapsedBeforePause = performance.now() - imageTimerStart;
          }
        }
      });

      // Silencio / Sonido
      btnSound?.addEventListener("click", () => {
        isMuted = !isMuted;
        slides.forEach((s) => {
          const v = s.querySelector("video");
          if (v) v.muted = isMuted;
        });

        if (soundIcon) {
          soundIcon.textContent = isMuted ? "volume_off" : "volume_up";
        }
        btnSound.setAttribute("title", isMuted ? "Activar sonido" : "Silenciar sonido");
      });

      // Iniciar en la primera diapositiva
      goToSlide(0);

      // Registrador de cleanup
      arranqueCleanup = () => {
        isDestroyed = true;
        stopCurrentMedia();
      };
    }

    function initPage() {
      setupHeaderPreview();
      setupArranquePlayer();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPage);
    } else {
      initPage();
    }
    document.addEventListener("astro:page-load", initPage);
  </script>
</Layout>
