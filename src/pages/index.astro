---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Quintanamur S.L. - Potencia Industrial al Servicio de la Obra y el Campo"
  description="Acondicionamiento extremo de terrenos, excavaciones, despedregado y plantación GPS en Yecla, Jumilla y comarca. Maquinaria propia sin intermediarios."
  activePage="inicio"
>
  <!-- Hero Section -->
  <section class="bg-inverse-surface relative overflow-hidden py-24 md:py-32">
    <div
      class="absolute inset-0 opacity-20 pointer-events-none"
      style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
    ></div>
    <div class="relative max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop z-10 grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
      <div class="md:col-span-8 lg:col-span-7">
        <span class="font-label-caps text-label-caps text-secondary-fixed-dim uppercase tracking-widest block mb-4">
          Maquinaria propia. No somos intermediarios
        </span>
        <h1 class="font-display-lg text-headline-lg-mobile md:text-display-lg text-inverse-on-surface mb-6 leading-tight">
          POTENCIA INDUSTRIAL AL SERVICIO DE LA OBRA Y EL CAMPO
        </h1>
        <p class="font-body-lg text-body-lg text-surface-container-high max-w-2xl mb-8 leading-relaxed">
          Acondicionamiento extremo de terrenos, excavaciones y plantación GPS en Yecla, Jumilla y comarca.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            class="bg-tertiary text-on-tertiary px-8 py-4 rounded hover:bg-tertiary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider shadow-md sharp-shadow"
            href="/contacto"
          >
            Solicitar Presupuesto
          </a>
          <a
            class="border-2 border-surface-container-high text-surface-container-high px-8 py-4 rounded hover:bg-surface-container-high/10 transition-colors font-label-caps text-label-caps uppercase tracking-wider"
            href="/servicios"
          >
            Ver Servicios
          </a>
        </div>
      </div>
      <div class="md:col-span-4 lg:col-span-5 mt-12 md:mt-0 relative hidden md:block">
        <div class="relative aspect-[4/3] rounded overflow-hidden shadow-[4px_8px_24px_rgba(0,0,0,0.3)] border border-secondary/20">
          <img
            class="w-full h-full object-cover"
            alt="Maquinaria pesada trabajando en el campo"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_fWquyK70zCpAd_XMNBTB9ku8hxrbHKVQmJFhaPh8fO1biWGcrvl8LtJb0kSmsVJxIdkrZy_G30Uqhlg28Bti18_fSGpWBoGcXaittENbnhcTWXjrofAF-fc0mNQZ4zjWreYSScSg01bp0RP9V2hcNQ1AECcId3N21g-fxCnFkAFeJAKBtcdHE3sUXhwDqXbpMnA7hn3vGLEfCH_rW2L9KWlm2hs_Z19ZJqWoweMdvwJxrtZL7LyH"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Nuestras Especialidades -->
  <section class="py-24 bg-surface relative">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2">Especialidades</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">NUESTRAS ESPECIALIDADES</h2>
        <div class="w-20 h-1 bg-secondary mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        <!-- Card 1: Servicios Agrícolas -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 shadow-[2px_4px_12px_rgba(126,86,39,0.05)] rounded flex flex-col justify-between sharp-shadow hover:sharp-shadow-hover transition-all">
          <div>
            <div class="relative aspect-[16/9] rounded overflow-hidden mb-6 shadow-sm">
              <img
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                alt="Retropala trabajando en obra civil y agricultura"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDyMryxq5ehJ7L1LsbS5tqwrgJpI0I28rcdsw2zGYsH83N8D6K3GJzBjPRx0S844jNVBPtBh7jDlJv8fdx9VE9e-yf3cFbeuGyVuTNQXCX8t6GIjH1BIDlO8vII9cE8QMtyyyORtEP5br3LF12VOS3bKq1cM0i3_q4t5vfGi4IPTU-b11-bJCRabqhK1mu0FvQyQ8GihpTYDcUzdrX5fVLCgtOaWTPcFIB8DIWEW3j1qQCpymdJzrtw"
                loading="lazy"
              />
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Servicios Agrícolas</h3>
            <p class="text-on-surface-variant mb-6 leading-relaxed">
              Despedregado, desfonde profundo, arranque de viña vieja y plantación automatizada con tecnología GPS Topcon.
            </p>
          </div>
          <div>
            <a
              class="inline-block bg-primary text-on-primary px-6 py-3 rounded hover:bg-primary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider"
              href="/servicios#servicios-agricolas"
            >
              VER SERVICIOS
            </a>
          </div>
        </div>

        <!-- Card 2: Excavaciones y Obra Civil -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 shadow-[2px_4px_12px_rgba(126,86,39,0.05)] rounded flex flex-col justify-between sharp-shadow hover:sharp-shadow-hover transition-all">
          <div>
            <div class="relative aspect-[16/9] rounded overflow-hidden mb-6 shadow-sm">
              <img
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                alt="Excavadora trabajando en obra civil"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDCl20vNgJsxqG6Fri5s7fLxmo00QzorHmpXWPYV6wSOKgTsxMb6DjmrV-dzDFQD7MyQFPw2_ghY8iylVSNqd4Uk8UeeOcTG4lWMqebixy77ZIAXob20qNGtvd7KggcfMVUGtkb6Kt7_4_2zOvl9uFnta08SXa6OFQqdLaDAN7uDLJWKcrkVPuzyGqowTlgvIBxMI-stgZ_qkzlr3Yhh4RAOuvkPp_7iqA2JRiZN7psBMwtvvLaHIg5"
                loading="lazy"
              />
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Excavaciones y Obra Civil</h3>
            <p class="text-on-surface-variant mb-6 leading-relaxed">
              Movimiento de tierras, cimentaciones, apertura de zanjas y trituración de asfalto u hormigón in situ.
            </p>
          </div>
          <div>
            <a
              class="inline-block bg-primary text-on-primary px-6 py-3 rounded hover:bg-primary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider"
              href="/servicios#obra-civil"
            >
              VER SERVICIOS
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Soluciones Agrícolas -->
  <section class="py-24 bg-surface-container-low border-t border-outline-variant/20">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span class="font-label-caps text-label-caps text-primary uppercase tracking-widest block mb-2">Agricultura Avanzada</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">SOLUCIONES AGRÍCOLAS</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Item 1 -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all">
          <div class="inline-block px-3 py-1 bg-primary/10 text-primary font-label-caps text-label-caps rounded-full mb-4">Agrícola</div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Despedregado de Fincas</h3>
          <p class="text-on-surface-variant">Trituramos la piedra directamente en tu parcela hasta alcanzar los 35 cm de profundidad. La roca se convierte en gravilla fina in situ.</p>
        </div>
        <!-- Item 2 -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all">
          <div class="inline-block px-3 py-1 bg-primary/10 text-primary font-label-caps text-label-caps rounded-full mb-4">Agrícola</div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Desfonde de Tierras</h3>
          <p class="text-on-surface-variant">Rajamos, ablandamos y volteamos el subsuelo. Enterramos malas hierbas y dejamos una cama de siembra perfecta para las raíces.</p>
        </div>
        <!-- Item 3 -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all">
          <div class="inline-block px-3 py-1 bg-primary/10 text-primary font-label-caps text-label-caps rounded-full mb-4">Tecnología GPS</div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Plantación con GPS</h3>
          <p class="text-on-surface-variant">Plantación de viñedo y almendros con máxima precisión. Filas perfectamente rectas en una sola pasada de forma mecanizada.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Soluciones de Obra Civil -->
  <section class="py-24 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2">Infraestructuras</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">SOLUCIONES DE OBRA CIVIL</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Item 1 -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all">
          <div class="inline-block px-3 py-1 bg-secondary/10 text-secondary font-label-caps text-label-caps rounded-full mb-4">Obra Civil</div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Excavación para Piscinas</h3>
          <p class="text-on-surface-variant">Ejecutamos excavaciones ajustándonos estrictamente a las cotas. Extracción, nivelación y retirada del material sobrante.</p>
        </div>
        <!-- Item 2 -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all">
          <div class="inline-block px-3 py-1 bg-secondary/10 text-secondary font-label-caps text-label-caps rounded-full mb-4">Obra Civil</div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Movimiento de Tierras</h3>
          <p class="text-on-surface-variant">Apertura de zanjas para canalizaciones, perfilado de cunetas, carga de material y levantamiento de pavimentos asfálticos.</p>
        </div>
        <!-- Item 3 -->
        <div class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all">
          <div class="inline-block px-3 py-1 bg-secondary/10 text-secondary font-label-caps text-label-caps rounded-full mb-4">Forestal</div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">Desbroce Forestal</h3>
          <p class="text-on-surface-variant">Despeje rápido y ecológico. Trituramos árboles enteros in situ para la reconversión de fincas y parques solares.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Potencia y Músculo Técnico -->
  <section class="py-24 bg-inverse-surface text-inverse-on-surface relative overflow-hidden">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop relative z-10">
      <div class="text-center mb-16">
        <span class="font-label-caps text-label-caps text-secondary-fixed-dim uppercase tracking-widest block mb-2">Flota y Capacidad</span>
        <h2 class="font-headline-lg text-headline-lg text-inverse-on-surface mb-4">POTENCIA Y MÚSCULO TÉCNICO</h2>
        <p class="font-body-lg text-body-lg text-surface-container-high max-w-2xl mx-auto">
          No somos intermediarios. Operamos con un parque de maquinaria propio de primer nivel, en constante renovación.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="bg-surface/5 p-8 border border-outline-variant/30 rounded backdrop-blur-sm">
          <div class="inline-block px-3 py-1 bg-primary text-on-primary font-label-caps text-label-caps rounded-full mb-4">100% Maquinaria Propia</div>
          <h3 class="font-headline-md text-headline-md text-surface-bright mb-4">Flota Fendt &amp; John Deere</h3>
          <p class="text-surface-container-high mb-6 leading-relaxed">
            El corazón de nuestra capacidad operativa. Tecnología alemana de máxima tracción capaz de arrastrar los implementos más pesados (como fresadoras de asfalto) rindiendo al máximo.
          </p>
          <h4 class="font-headline-md text-headline-md text-surface-bright text-lg mb-2">Implementos de Alto Rendimiento</h4>
          <p class="text-surface-container-high leading-relaxed">
            Equipos duales para obra y agricultura: Retropala Mixta TrinityB 432, Fresadora "Molino de Piedra", Trituradora Forestal TFT Cancela y Guiado Satelital GPS Topcon.
          </p>
        </div>
        <div class="relative aspect-[4/3] rounded overflow-hidden shadow-2xl border border-secondary/30">
          <img
            class="w-full h-full object-cover"
            alt="John Deere y tractores de alta potencia operando"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBNsvyx2f9pe0Slgyl6zybWGmeisMqj20GXXsZ1cSYXBB-iRDT1w8CWvRZDGOaJ3spxXxQMaPNLve2yr5Hb9Y6MR3URX3Ga2D9U5Tu4nn6yoqpMZSqz5S5MFsz1knQKuAjjOGpT7e5A5xz4XbRmWvp2H68ybpLlyrHGXzCCFNkWtLPr5czQzhNlTri618TzsWdk6l9-3F2veuY1YC8WhEUfRwN6pNY_n7Hpy0i4u6rFYAvulZU_rxr9"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section: De la Casa Quintana a la Alta Tecnología -->
  <section class="py-24 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-6">
        <span class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2">Nuestra Historia</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-6">DE LA CASA QUINTANA A LA ALTA TECNOLOGÍA</h2>
        <h3 class="font-headline-md text-headline-md text-primary mb-4">Las raíces en la tierra</h3>
        <p class="text-on-surface-variant mb-4 leading-relaxed">
          Detrás de cada gran máquina hay unas manos que conocen la tierra desde niños. Todo comenzó con Pepe en Yecla. Su filosofía era simple: trabajar bien y dar la cara. El trabajo duro dio sus frutos.
        </p>
        <p class="text-on-surface-variant mb-8 leading-relaxed">
          Hoy, con el relevo de su hijo Luis y el salto a la obra civil, Quintanamur S.L. es el puente perfecto entre la tradición agrícola y la fuerza de la maquinaria industrial.
        </p>
        <a
          class="inline-block bg-secondary text-on-secondary px-6 py-3 rounded hover:bg-secondary-container hover:text-on-secondary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider"
          href="/sobre-nosotros"
        >
          LEER NUESTRA HISTORIA
        </a>
      </div>
      <div class="md:col-span-6">
        <div class="relative aspect-[4/3] rounded overflow-hidden shadow-xl border border-secondary/20">
          <img
            class="w-full h-full object-cover"
            alt="Historia y tradición en el campo"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_fWquyK70zCpAd_XMNBTB9ku8hxrbHKVQmJFhaPh8fO1biWGcrvl8LtJb0kSmsVJxIdkrZy_G30Uqhlg28Bti18_fSGpWBoGcXaittENbnhcTWXjrofAF-fc0mNQZ4zjWreYSScSg01bp0RP9V2hcNQ1AECcId3N21g-fxCnFkAFeJAKBtcdHE3sUXhwDqXbpMnA7hn3vGLEfCH_rW2L9KWlm2hs_Z19ZJqWoweMdvwJxrtZL7LyH"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Contacto / Llamada final -->
  <section class="py-20 bg-surface-container-high border-t border-outline-variant/30 text-center">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">¿Hablamos de tu proyecto?</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-xl mx-auto">
        Servicio en Yecla, Jumilla, Villena y comarcas limítrofes.
      </p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a
          class="bg-tertiary text-on-tertiary px-8 py-4 rounded hover:bg-tertiary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider shadow-md sharp-shadow"
          href="/contacto"
        >
          SOLICITAR PRESUPUESTO
        </a>
        <a
          class="bg-secondary text-on-secondary px-8 py-4 rounded hover:bg-secondary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider shadow-md"
          href="mailto:info@quintanamur.com"
        >
          Contactar por Email
        </a>
      </div>
      <p class="mt-6 text-on-surface-variant font-label-caps text-label-caps">info@quintanamur.com | Yecla (Murcia)</p>
    </div>
  </section>
</Layout>
