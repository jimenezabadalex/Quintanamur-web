---
import Layout from "../layouts/Layout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { url } from "../utils/url";
---

<Layout
  title="Maquinaria Agrícola y Obra Civil | Quintanamur"
  description="Servicios de excavación, movimiento de tierras, trituración forestal, despedregado y plantación GPS en Yecla y comarca. "
  activePage="inicio"
>
  <!-- Hero Section Cinemático: Ambient Glow + Vídeo Íntegro a la Derecha sin Cortes (Bucle Directo / Reversa) -->
  <header
    id="home-hero"
    class="bg-inverse-surface relative overflow-hidden min-h-[640px] md:min-h-[720px] lg:min-h-[780px] xl:min-h-[820px] flex items-center py-24 md:py-32"
  >
    <!-- Capa 1: Ambient Glow Dinámico de Fondo (Reflejo cinemático en tiempo real) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
      <video
        id="home-ambient-forward"
        class="absolute inset-0 w-full h-full object-cover object-center scale-125 filter blur-[60px] md:blur-[100px] opacity-30 md:opacity-40 transition-opacity duration-700"
        src={url("/images/home/hero-home-square.mp4")}
        autoplay
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>
      <video
        id="home-ambient-reverse"
        class="absolute inset-0 w-full h-full object-cover object-center scale-125 filter blur-[60px] md:blur-[100px] opacity-0 transition-opacity duration-700"
        src={url("/images/home/hero-home-reverse.mp4")}
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>
    </div>

    <!-- Capa 2: Vídeo Principal Íntegro a la Derecha (Sin Cortes en sus 4 Lados, Bucle Directo / Reversa) -->
    <div
      class="absolute inset-y-0 right-0 w-full md:w-3/5 lg:w-1/2 flex items-center justify-end pointer-events-none z-1 overflow-hidden"
    >
      <div class="relative h-full aspect-square flex items-center justify-end">
        <video
          id="home-video-forward"
          class="h-full w-auto aspect-square object-contain object-right hero-video-mask transition-opacity duration-700 opacity-100"
          src={url("/images/home/hero-home-square.mp4")}
          autoplay
          muted
          playsinline
          preload="auto"
        ></video>
        <video
          id="home-video-reverse"
          class="absolute inset-0 h-full w-auto aspect-square object-contain object-right hero-video-mask transition-opacity duration-700 opacity-0"
          src={url("/images/home/hero-home-reverse.mp4")}
          muted
          playsinline
          preload="auto"
        ></video>
      </div>
    </div>

    <!-- Capa 3: Gradient Overlay Lateral de Alto Contraste para el Texto -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-inverse-surface via-inverse-surface/85 to-inverse-surface/40 md:via-inverse-surface/80 md:to-transparent pointer-events-none z-2"
    >
    </div>

    <!-- Capa 4: Fusión Transparente Continua hacia la Siguiente Sección (bg-surface) -->
    <div
      class="absolute bottom-0 inset-x-0 h-32 sm:h-44 md:h-56 bg-gradient-to-t from-surface via-surface/60 to-transparent pointer-events-none z-3"
    >
    </div>

    <!-- Foreground Content -->
    <div
      class="relative max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop z-10 w-full"
    >
      <div class="max-w-2xl lg:max-w-3xl">
        <span
          class="font-label-caps text-label-caps text-secondary-fixed-dim uppercase tracking-widest block mb-4"
        >
          Maquinaria propia. No somos intermediarios
        </span>
        <h1
          class="font-display-lg text-headline-lg-mobile md:text-display-lg lg:text-[60px] font-extrabold mb-5 text-on-primary leading-tight"
        >
          MAQUINARIA AL SERVICIO DE LA OBRA Y EL CAMPO
        </h1>
        <p
          class="font-body-lg text-body-lg md:text-[19px] text-inverse-on-surface max-w-xl leading-relaxed mb-8"
        >
          Acondicionamiento extremo de terrenos, excavaciones y plantación GPS
          en Yecla, Jumilla y comarca.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            class="btn-agricola w-full sm:w-auto text-center"
            href={url("/maquinaria")}
          >
            VER NUESTRA FLOTA
          </a>
          <a
            class="btn-obra w-full sm:w-auto text-center"
            href={url("/servicios")}
          >
            Ver Servicios
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Section: Nuestras Especialidades -->
  <section class="py-24 bg-surface relative">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span
          class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2"
          >Especialidades</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">
          ESPECIALIDADES EN OBRA Y CAMPO
        </h2>
        <div class="w-20 h-1 bg-secondary mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        <!-- Card 1: Servicios Agrícolas -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 shadow-[2px_4px_12px_rgba(126,86,39,0.05)] rounded flex flex-col justify-between sharp-shadow hover:sharp-shadow-hover transition-all"
        >
          <div>
            <div
              class="relative aspect-[16/9] rounded overflow-hidden mb-6 shadow-sm"
            >
              <img
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                alt="Tractor agrícola realizando labores de preparación y desfonde de suelo"
                src={url("/images/home/card-servicios-agricolas.webp")}
                loading="lazy"
              />
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Servicios Agrícolas de Precisión
            </h3>
            <p class="text-on-surface-variant mb-6 leading-relaxed">
              Despedregado, desfonde profundo, arranque de viña vieja y
              plantación automatizada con tecnología GPS Topcon.
            </p>
          </div>
          <div>
            <a
              class="btn-agricola"
              href={url("/servicios#servicios-agricolas")}
            >
              VER SERVICIOS
            </a>
          </div>
        </div>

        <!-- Card 2: Excavaciones y Obra Civil -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 shadow-[2px_4px_12px_rgba(126,86,39,0.05)] rounded flex flex-col justify-between sharp-shadow hover:sharp-shadow-hover transition-all"
        >
          <div>
            <div
              class="relative aspect-[16/9] rounded overflow-hidden mb-6 shadow-sm"
            >
              <img
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                alt="Excavadora de cadenas ejecutando zanja y movimiento de tierras"
                src={url("/images/home/card-obra-civil.webp")}
                loading="lazy"
              />
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Excavaciones y Obra Civil
            </h3>
            <p class="text-on-surface-variant mb-6 leading-relaxed">
              Movimiento de tierras, cimentaciones, apertura de zanjas y
              trituración de asfalto u hormigón in situ.
            </p>
          </div>
          <div>
            <a class="btn-obra" href={url("/servicios#obra-civil")}>
              VER SERVICIOS
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Soluciones Agrícolas -->
  <section
    class="py-24 bg-surface-container-low border-t border-outline-variant/20"
  >
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span
          class="font-label-caps text-label-caps text-primary uppercase tracking-widest block mb-2"
          >Agricultura Avanzada</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          SOLUCIONES AGRÍCOLAS
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Item 1: Despedregado -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 transition-all duration-300 group-hover:bg-primary group-hover:text-on-primary group-hover:scale-105 shadow-sm"
            >
              <!-- Icono Piedra con Grieta Central y Granos de Trituración en Base -->
              <svg
                class="w-7 h-7"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 15L7 5L17 4L20 12L17.5 17.5L6.5 17.5L4 15Z"></path>
                <path d="M12 4.5L10.5 9L13.5 12.5L11.5 17.5"></path>
                <circle cx="4.5" cy="20.5" r="0.9" fill="currentColor"></circle>
                <circle cx="8.5" cy="21" r="0.9" fill="currentColor"></circle>
                <circle cx="12" cy="20.5" r="0.9" fill="currentColor"></circle>
                <circle cx="15.5" cy="21" r="0.9" fill="currentColor"></circle>
                <circle cx="19.5" cy="20.5" r="0.9" fill="currentColor"
                ></circle>
              </svg>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Despedregado de Fincas
            </h3>
            <p class="text-on-surface-variant leading-relaxed">
              Trituramos la piedra directamente en tu parcela hasta alcanzar los
              35 cm de profundidad. La roca se convierte en gravilla fina in
              situ.
            </p>
          </div>
          <a
            href={url("/servicios#servicios-agricolas")}
            class="mt-6 btn-card-link-agricola group"
          >
            <span>Saber más</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>

        <!-- Item 2: Desfonde -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 transition-all duration-300 group-hover:bg-primary group-hover:text-on-primary group-hover:scale-105 shadow-sm"
            >
              <!-- Icono Rastro de Arado Recto en Perspectiva (Sin curvas) -->
              <svg
                class="w-7 h-7"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 7H22"></path>
                <path d="M2 20L6 7"></path>
                <path d="M22 20L18 7"></path>
                <path d="M5.5 20L8.5 7"></path>
                <path d="M9.5 20L11 7"></path>
                <path d="M14.5 20L13 7"></path>
                <path d="M18.5 20L15.5 7"></path>
                <path d="M2 20H22"></path>
              </svg>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Desfonde de Tierras
            </h3>
            <p class="text-on-surface-variant leading-relaxed">
              Rajamos, ablandamos y volteamos el subsuelo. Enterramos malas
              hierbas y dejamos una cama de siembra perfecta para las raíces.
            </p>
          </div>
          <a
            href={url("/servicios#servicios-agricolas")}
            class="mt-6 btn-card-link-agricola group"
          >
            <span>Saber más</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>

        <!-- Item 3: Plantación GPS -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-6 transition-all duration-300 group-hover:bg-primary group-hover:text-on-primary group-hover:scale-105 shadow-sm"
            >
              <span class="material-symbols-outlined text-3xl"
                >satellite_alt</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Plantación con GPS
            </h3>
            <p class="text-on-surface-variant leading-relaxed">
              Plantación de viñedo y almendros con máxima precisión. Filas
              perfectamente rectas en una sola pasada de forma mecanizada.
            </p>
          </div>
          <a
            href={url("/servicios#servicios-agricolas")}
            class="mt-6 btn-card-link-agricola group"
          >
            <span>Saber más</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Soluciones de Obra Civil -->
  <section class="py-24 bg-surface">
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span
          class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2"
          >Infraestructuras</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface">
          SOLUCIONES DE OBRA CIVIL
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Item 1: Excavación / Retro -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center mb-6 transition-all duration-300 group-hover:bg-secondary group-hover:text-on-secondary group-hover:scale-105 shadow-sm"
            >
              <!-- Icono Retroexcavadora -->
              <svg
                class="w-7 h-7"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="17" width="12" height="5" rx="2.5"></rect>
                <circle cx="5" cy="19.5" r="0.8" fill="currentColor"></circle>
                <circle cx="8" cy="19.5" r="0.8" fill="currentColor"></circle>
                <circle cx="11" cy="19.5" r="0.8" fill="currentColor"></circle>
                <path d="M4 17V11a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v6"></path>
                <path d="M5.5 12h3.5"></path>
                <path d="M11 13l4-5 3.5 2.5"></path>
                <path d="M18.5 10.5l2.5 3-2 1.5-2-2.5z" fill="currentColor"
                ></path>
              </svg>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Excavación para Piscinas
            </h3>
            <p class="text-on-surface-variant leading-relaxed">
              Ejecutamos excavaciones ajustándonos estrictamente a las cotas.
              Extracción, perfilado del terreno y retirada del material
              sobrante.
            </p>
          </div>
          <a
            href={url("/servicios#obra-civil")}
            class="mt-6 btn-card-link-obra group"
          >
            <span>Saber más</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>

        <!-- Item 2: Movimiento de Tierras -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center mb-6 transition-all duration-300 group-hover:bg-secondary group-hover:text-on-secondary group-hover:scale-105 shadow-sm"
            >
              <span class="material-symbols-outlined text-3xl">engineering</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Movimiento de Tierras
            </h3>
            <p class="text-on-surface-variant leading-relaxed">
              Apertura de zanjas para canalizaciones, carga de material y
              levantamiento de pavimentos asfálticos.
            </p>
          </div>
          <a
            href={url("/servicios#obra-civil")}
            class="mt-6 btn-card-link-obra group"
          >
            <span>Saber más</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>

        <!-- Item 3: Desbroce Forestal -->
        <div
          class="bg-surface-container-lowest p-8 border border-secondary/10 rounded shadow-sm sharp-shadow hover:sharp-shadow-hover transition-all duration-300 group flex flex-col justify-between"
        >
          <div>
            <div
              class="w-14 h-14 rounded-xl bg-secondary/10 text-secondary flex items-center justify-center mb-6 transition-all duration-300 group-hover:bg-secondary group-hover:text-on-secondary group-hover:scale-105 shadow-sm"
            >
              <span class="material-symbols-outlined text-3xl">forest</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
              Desbroce Forestal de Terrenos
            </h3>
            <p class="text-on-surface-variant leading-relaxed">
              Despeje rápido y ecológico. Trituramos árboles enteros in situ
              para la reconversión de fincas y parques solares.
            </p>
          </div>
          <a
            href={url("/servicios#obra-civil")}
            class="mt-6 btn-card-link-obra group"
          >
            <span>Saber más</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Potencia y Músculo Técnico -->
  <section
    class="py-24 bg-surface-container-low border-t border-outline-variant/20"
  >
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div class="text-center mb-16">
        <span
          class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2"
          >Flota y Capacidad</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-4">
          Maquinaria y Equipamiento
        </h2>
        <p
          class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed"
        >
          No somos intermediarios. Operamos con un parque de maquinaria propio
          de primer nivel, en constante renovación.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div
          class="bg-surface-container-lowest p-8 border border-outline-variant/30 rounded-lg sharp-shadow flex flex-col justify-between"
        >
          <div
            class="inline-block self-start px-3 py-1 bg-primary text-on-primary font-label-caps text-label-caps rounded-full mb-4 shadow-sm"
          >
            100% Maquinaria Propia
          </div>
          <h3 class="font-headline-md text-headline-md text-on-surface mb-3">
            Flota 100% Fendt: Potencia Vario
          </h3>
          <p class="text-on-surface-variant mb-6 leading-relaxed">
            El corazón de nuestra capacidad operativa: Fendt 933, Fendt 930 y
            Fendt 722. Tecnología alemana de máxima tracción y guiado por
            satélite, capaz de arrastrar los implementos más pesados rindiendo
            al máximo.
          </p>
          <h4
            class="font-headline-md text-headline-md text-on-surface text-lg mb-2"
          >
            Implementos de Alto Rendimiento
          </h4>
          <p class="text-on-surface-variant leading-relaxed mb-8">
            Equipos duales para obra y agricultura: Retropala Mixta Caterpillar
            432, Fresadora FI-IVAN "Molino de Piedra", Trituradora Forestal TFT
            Cancela y Guiado Satelital GPS Topcon.
          </p>
          <div>
            <a href={url("/maquinaria")} class="btn-agricola group">
              <span>EXPLORAR NUESTRA FLOTA</span>
              <span
                class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>
        <div
          class="relative aspect-[4/3] rounded-lg overflow-hidden shadow-xl border border-outline-variant/30"
        >
          <img
            class="w-full h-full object-cover"
            alt="Flota de tractores Fendt de alta potencia para trabajos agrícolas"
            src={url("/images/home/flota-alta-potencia.webp")}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section: De la Casa Quintana a la Alta Tecnología -->
  <section class="py-24 bg-surface">
    <div
      class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-12 gap-12 items-center"
    >
      <div class="md:col-span-6">
        <span
          class="font-label-caps text-label-caps text-secondary uppercase tracking-widest block mb-2"
          >Nuestra Historia</span
        >
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-6">
          HISTORIA Y RAÍCES DE QUINTANAMUR
        </h2>
        <h3 class="font-headline-md text-headline-md text-primary mb-4">
          Las raíces en la tierra
        </h3>
        <p class="text-on-surface-variant mb-4 leading-relaxed">
          Detrás de cada gran máquina hay unas manos que conocen la tierra desde
          niños. Todo comenzó con Pepe en Yecla. Su filosofía era simple:
          trabajar bien y dar la cara. El trabajo duro dio sus frutos.
        </p>
        <p class="text-on-surface-variant mb-8 leading-relaxed">
          Hoy, con el relevo de su hijo Luis y el salto a la obra civil,
          Quintanamur S.L. es el puente perfecto entre la tradición agrícola y
          la fuerza de la maquinaria industrial.
        </p>
        <a class="btn-obra" href={url("/sobre-nosotros")}>
          CONOCE NUESTRA HISTORIA
        </a>
      </div>
      <div class="md:col-span-6">
        <div
          class="relative aspect-[4/3] rounded overflow-hidden shadow-xl border border-secondary/20"
        >
          <img
            class="w-full h-full object-cover"
            alt="Maquinaria agrícola tradicional trabajando la tierra en fincas de Yecla"
            src={url("/images/home/historia-raices.webp")}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Contacto / Llamada final -->
  <CtaBanner
    title="¿Hablamos de tu proyecto?"
    description="Servicio en Yecla, Jumilla, Villena y comarcas limítrofes. Maquinaria propia sin intermediarios."
    showContactPage={true}
  />

  <style>
    .hero-video-mask {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.4) 15%, black 35%, black 100%);
      mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.4) 15%, black 35%, black 100%);
    }
  </style>

  <script>
    function setupHomeHeroVideo() {
      const videoFwd = document.getElementById("home-video-forward") as HTMLVideoElement | null;
      const videoRev = document.getElementById("home-video-reverse") as HTMLVideoElement | null;
      const ambientFwd = document.getElementById("home-ambient-forward") as HTMLVideoElement | null;
      const ambientRev = document.getElementById("home-ambient-reverse") as HTMLVideoElement | null;
      const hero = document.getElementById("home-hero");
      if (!videoFwd || !videoRev || !hero) return;

      let currentDirection: "forward" | "reverse" = "forward";
      let pauseTimeout: number | null = null;
      let isUserScrolledDown = false;
      let lastScrollY = window.scrollY;

      function showAndPlay(dir: "forward" | "reverse") {
        currentDirection = dir;
        if (dir === "forward") {
          // Mostrar activo
          videoFwd.classList.remove("opacity-0");
          videoFwd.classList.add("opacity-100");
          videoRev.classList.remove("opacity-100");
          videoRev.classList.add("opacity-0");

          if (ambientFwd && ambientRev) {
            ambientFwd.classList.remove("opacity-0");
            ambientFwd.classList.add("opacity-30", "md:opacity-40");
            ambientRev.classList.remove("opacity-30", "md:opacity-40");
            ambientRev.classList.add("opacity-0");
          }

          videoFwd.currentTime = 0;
          videoFwd.play().catch(() => {});
          if (ambientFwd) {
            ambientFwd.currentTime = 0;
            ambientFwd.play().catch(() => {});
          }
        } else {
          // Mostrar reverso
          videoRev.classList.remove("opacity-0");
          videoRev.classList.add("opacity-100");
          videoFwd.classList.remove("opacity-100");
          videoFwd.classList.add("opacity-0");

          if (ambientFwd && ambientRev) {
            ambientRev.classList.remove("opacity-0");
            ambientRev.classList.add("opacity-30", "md:opacity-40");
            ambientFwd.classList.remove("opacity-30", "md:opacity-40");
            ambientFwd.classList.add("opacity-0");
          }

          videoRev.currentTime = 0;
          videoRev.play().catch(() => {});
          if (ambientRev) {
            ambientRev.currentTime = 0;
            ambientRev.play().catch(() => {});
          }
        }
      }

      function pauseAll() {
        videoFwd?.pause();
        videoRev?.pause();
        ambientFwd?.pause();
        ambientRev?.pause();
      }

      function resumeCurrent() {
        if (isUserScrolledDown) return;
        if (currentDirection === "forward") {
          videoFwd?.play().catch(() => {});
          ambientFwd?.play().catch(() => {});
        } else {
          videoRev?.play().catch(() => {});
          ambientRev?.play().catch(() => {});
        }
      }

      // Alternar al finalizar un vídeo: espera 4 segundos y lanza la dirección contraria
      function handleVideoEnded(endedDirection: "forward" | "reverse") {
        if (isUserScrolledDown || endedDirection !== currentDirection) return;
        if (pauseTimeout) clearTimeout(pauseTimeout);

        pauseTimeout = window.setTimeout(() => {
          if (!isUserScrolledDown && !document.hidden) {
            const nextDir = currentDirection === "forward" ? "reverse" : "forward";
            showAndPlay(nextDir);
          }
        }, 4000);
      }

      videoFwd.addEventListener("ended", () => handleVideoEnded("forward"));
      videoRev.addEventListener("ended", () => handleVideoEnded("reverse"));

      // Arrancar con el vídeo directo al inicio
      showAndPlay("forward");

      // Control de scroll:
      // Al hacer scroll hacia abajo -> se para
      // Al hacer scroll hacia arriba -> se ejecuta de nuevo desde el inicio directo (0:00)
      function handleScroll() {
        const currentScrollY = window.scrollY;
        const heroHeight = hero.offsetHeight || 500;

        if (currentScrollY > 50 && currentScrollY > lastScrollY) {
          // Usuario hace scroll hacia abajo
          if (!isUserScrolledDown) {
            isUserScrolledDown = true;
            if (pauseTimeout) clearTimeout(pauseTimeout);
            pauseAll();
          }
        } else if (currentScrollY <= 50 || (currentScrollY < lastScrollY && currentScrollY < heroHeight)) {
          // Usuario hace scroll hacia arriba y vuelve a la zona del hero
          if (isUserScrolledDown) {
            isUserScrolledDown = false;
            if (pauseTimeout) clearTimeout(pauseTimeout);
            showAndPlay("forward");
          }
        }

        lastScrollY = currentScrollY;
      }

      window.addEventListener("scroll", handleScroll, { passive: true });

      // IntersectionObserver para asegurar pausa cuando el hero ya no está en pantalla
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              if (pauseTimeout) clearTimeout(pauseTimeout);
              pauseAll();
            } else if (window.scrollY <= 50) {
              if (isUserScrolledDown) {
                isUserScrolledDown = false;
                showAndPlay("forward");
              } else {
                resumeCurrent();
              }
            }
          });
        },
        { threshold: 0.15 }
      );

      observer.observe(hero);
    }

    document.addEventListener("DOMContentLoaded", setupHomeHeroVideo);
    document.addEventListener("astro:page-load", setupHomeHeroVideo);
    setupHomeHeroVideo();
  </script>
</Layout>
