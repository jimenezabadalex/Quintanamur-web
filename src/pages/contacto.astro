---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto y Presupuesto - Quintanamur S.L."
  description="Contacta con Quintanamur S.L. para solicitar presupuesto de movimiento de tierras, despedregado, obra civil y servicios agrícolas en Yecla y comarca."
  activePage="contacto"
>
  <!-- Hero Section -->
  <section class="bg-inverse-surface text-surface py-16 md:py-24 relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-20 pointer-events-none bg-cover bg-center"
      style="background-image: url('/images/contacto/hero-contacto-bg.webp');"
    ></div>
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop relative z-10 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 mb-6 text-primary-fixed-dim font-label-caps text-label-caps border border-primary-fixed-dim/30 px-3 py-1 rounded-full">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">handshake</span>
        <span>ATENCIÓN PERSONALIZADA</span>
      </div>
      <h1 class="font-display-lg text-headline-lg-mobile md:text-display-lg font-extrabold text-surface-bright mb-6 max-w-4xl tracking-tight leading-tight">
        Hablemos de tu Proyecto
      </h1>
      <p class="font-body-lg text-body-lg text-surface-variant/90 max-w-2xl mx-auto leading-relaxed">
        No importa si es una parcela agrícola de 50 hectáreas o la cimentación de una nave industrial. Tenemos la máquina exacta para el trabajo. Estamos en Yecla y trabajamos en toda la comarca, Altiplano, Alicante y Albacete.
      </p>
    </div>
  </section>

  <!-- Two Column Layout -->
  <section class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Column Left (Contacto Directo y Base Operativa) -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="bg-surface-variant border border-outline-variant/20 rounded-xl p-8 flex flex-col gap-8 sharp-shadow h-full">
          <div>
            <h2 class="font-headline-md text-headline-md font-bold text-on-surface mb-6">Contacto Directo</h2>
            <div class="flex flex-col gap-6">
              <a
                class="flex items-center gap-4 group p-4 bg-surface rounded-lg border border-outline-variant/30 hover:border-primary/50 transition-colors"
                href="tel:+34600000000"
              >
                <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary group-hover:scale-110 transition-transform">
                  <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">call</span>
                </div>
                <div>
                  <div class="font-label-caps text-label-caps text-outline mb-1">LLÁMANOS DIRECTAMENTE</div>
                  <div class="font-body-lg text-body-lg font-medium text-on-surface">+34 600 00 00 00</div>
                </div>
              </a>

              <a
                class="w-full bg-[#25D366] text-white font-body-lg font-bold py-4 px-6 rounded-lg hover:bg-[#20bd5a] transition-colors flex items-center justify-center gap-3 btn-active sharp-shadow"
                href="https://wa.me/34600000000"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"></path>
                </svg>
                Contactar por WhatsApp
              </a>
            </div>
          </div>

          <div class="mt-4">
            <h3 class="font-headline-md text-body-lg font-bold text-on-surface mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">location_on</span>
              Nuestra Base
            </h3>
            <p class="font-body-md text-on-surface-variant mb-4 leading-relaxed">
              Yecla, Región de Murcia. Prestando servicio al Altiplano, Alicante y Albacete.
            </p>
            <!-- Stylized Map -->
            <div class="w-full h-48 bg-surface-container rounded-lg border border-outline-variant/30 overflow-hidden relative group">
              <div
                class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                style="background-image: url('/images/contacto/mapa-base-yecla.webp');"
              ></div>
              <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/60 to-transparent flex items-end p-4">
                <span class="text-surface font-label-caps text-label-caps tracking-widest bg-primary/80 px-2 py-1 rounded backdrop-blur-sm">
                  YECLA 38.61° N, 1.11° W
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Column Right (Formulario Inteligente de Presupuesto) -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="bg-surface border border-outline-variant/20 rounded-xl p-8 md:p-10 sharp-shadow h-full relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-40 h-40 bg-surface-container-high rounded-full opacity-50 pointer-events-none"></div>
          <div class="relative z-10">
            <h2 class="font-headline-md text-headline-lg-mobile md:text-headline-md font-bold text-on-surface mb-2">
              Solicita Valoración Sin Compromiso
            </h2>
            <p class="font-body-md text-on-surface-variant mb-8 leading-relaxed">
              Rellena los detalles a continuación y te contactaremos en menos de 24 horas laborables.
            </p>

            <form class="flex flex-col gap-6" id="lead-form">
              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="sector">
                  Sector de Actuación
                </label>
                <div class="relative">
                  <select
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:border-primary appearance-none outline-none transition-all shadow-sm"
                    id="sector"
                    name="sector"
                    required
                  >
                    <option disabled selected value="">Selecciona un sector...</option>
                    <option value="agricola">Servicios Agrícolas</option>
                    <option value="civil">Obra Civil / Excavación</option>
                    <option value="otro">Otro</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-outline">
                    <span class="material-symbols-outlined">expand_more</span>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="name">
                    Tu Nombre o Empresa
                  </label>
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm"
                    id="name"
                    name="name"
                    placeholder="Ej. Finca San José"
                    type="text"
                    required
                  />
                </div>
                <div class="flex flex-col gap-2">
                  <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="phone">
                    Teléfono de Contacto
                  </label>
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm"
                    id="phone"
                    name="phone"
                    placeholder="+34 600 00 00 00"
                    type="tel"
                    required
                  />
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="location">
                  Población / Finca (Ubicación)
                </label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-4 text-outline/60 pointer-events-none">
                    <span class="material-symbols-outlined text-sm">pin_drop</span>
                  </div>
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg pl-10 pr-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm"
                    id="location"
                    name="location"
                    placeholder="Indica dónde se realizará el trabajo"
                    type="text"
                    required
                  />
                </div>
              </div>

              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="message">
                  Cuéntanos qué necesitas (Breve)
                </label>
                <textarea
                  class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm resize-none"
                  id="message"
                  name="message"
                  placeholder="Desbroce de 20 hectáreas, zanjeo para tuberías..."
                  rows="4"
                  required
                ></textarea>
              </div>

              <div class="mt-4">
                <button
                  class="w-full bg-primary text-on-primary font-body-lg font-bold py-4 px-6 rounded-lg hover:bg-primary-container transition-colors flex items-center justify-center gap-2 btn-active sharp-shadow group cursor-pointer"
                  type="submit"
                >
                  <span>Enviar Solicitud</span>
                  <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </button>
                <p class="font-body-md text-xs text-outline text-center mt-4">
                  Al enviar este formulario, aceptas nuestra política de privacidad con respecto al tratamiento de datos.
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
