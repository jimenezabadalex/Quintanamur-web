---
import Layout from '../layouts/Layout.astro';
import { url } from '../utils/url';
---

<Layout
  title="Contacto y Presupuesto - Quintanamur S.L."
  description="Contacta con Quintanamur S.L. para solicitar presupuesto de movimiento de tierras, despedregado, obra civil y servicios agrícolas en Yecla y comarca."
  activePage="contacto"
>
  <!-- Leaflet CSS goes into <head> via named slot -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" slot="head" />

  <!-- Hero Section -->
  <section class="bg-inverse-surface text-surface py-16 md:py-24 relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-20 pointer-events-none bg-cover bg-center"
      style={`background-image: url('${url('/images/contacto/hero-contacto-bg.webp')}');`}
    ></div>
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop relative z-10 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 mb-6 text-primary-fixed-dim font-label-caps text-label-caps border border-primary-fixed-dim/30 px-3 py-1 rounded-full">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">handshake</span>
        <span>ATENCIÓN PERSONALIZADA</span>
      </div>
      <h1 class="font-display-lg text-headline-lg-mobile md:text-display-lg lg:text-[60px] font-extrabold text-on-primary mb-6 max-w-4xl tracking-tight leading-tight">
        HABLEMOS DE TU PROYECTO
      </h1>
      <p class="font-body-lg text-body-lg md:text-[19px] text-inverse-on-surface max-w-2xl mx-auto leading-relaxed">
        No importa si es una parcela agrícola de 50 hectáreas o la cimentación de una nave industrial. Tenemos la máquina exacta para el trabajo. Estamos en Yecla y trabajamos en toda la comarca, Altiplano, Alicante y Albacete.
      </p>
    </div>
  </section>

  <!-- Coverage Checker Tool -->
  <section class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-10 md:py-14 w-full">
    <div class="bg-surface-container-low border border-outline-variant/30 rounded-2xl overflow-hidden sharp-shadow">
      <!-- Header -->
      <div class="px-6 sm:px-10 py-6 border-b border-outline-variant/20 flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="flex items-center gap-3 flex-1">
          <div class="w-10 h-10 bg-primary/15 rounded-full flex items-center justify-center text-primary flex-shrink-0">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">my_location</span>
          </div>
          <div>
            <h2 class="font-headline-md text-body-lg font-bold text-on-surface">¿Trabajamos en tu zona?</h2>
            <p class="font-body-md text-on-surface-variant text-sm">Zona de cobertura directa: 150 km desde Yecla (Murcia)</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-2">
          <button
            id="btn-detect-location"
            class="btn-agricola text-sm py-2.5 px-4 group cursor-pointer"
            type="button"
          >
            <span class="material-symbols-outlined text-base group-hover:animate-pulse" style="font-variation-settings: 'FILL' 1;">near_me</span>
            <span>Detectar mi ubicación</span>
          </button>
          <div class="relative flex-1 sm:w-56">
            <input
              id="map-search"
              type="text"
              placeholder="Buscar municipio..."
              class="w-full bg-surface border border-outline-variant rounded-lg pl-9 pr-4 py-2.5 font-body-md text-on-surface text-sm placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all"
            />
            <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-outline/60 text-sm pointer-events-none">search</span>
          </div>
        </div>
      </div>

      <!-- Map -->
      <div id="coverage-map" class="w-full" style="height: 380px;"></div>

      <!-- Status Card -->
      <div id="coverage-status" class="px-6 sm:px-10 py-5 hidden">
        <div id="coverage-inner" class="flex items-start gap-4 rounded-xl p-5 border transition-all duration-500">
          <div id="coverage-icon" class="w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0 text-xl font-bold"></div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 mb-1">
              <p id="coverage-title" class="font-headline-md text-body-lg font-bold"></p>
              <span id="coverage-badge" class="inline-flex items-center gap-1 font-label-caps text-label-caps px-2.5 py-0.5 rounded-full text-xs font-bold self-start"></span>
            </div>
            <p id="coverage-message" class="font-body-md text-sm leading-relaxed"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two Column Layout -->
  <section class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop py-2 md:py-8 pb-12 md:pb-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
      <!-- Column Left -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="bg-surface-variant border border-outline-variant/20 rounded-xl p-6 sm:p-8 flex flex-col gap-8 sharp-shadow h-full">
          <div>
            <h2 class="font-headline-md text-headline-md font-bold text-on-surface mb-6">Contacto Directo</h2>
            <div class="flex flex-col gap-6">
              <a class="flex items-center gap-4 group p-4 bg-surface rounded-lg border border-outline-variant/30 hover:border-primary/50 transition-colors" href="tel:+34600000000">
                <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary group-hover:scale-110 transition-transform flex-shrink-0">
                  <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">call</span>
                </div>
                <div class="min-w-0">
                  <div class="font-label-caps text-label-caps text-outline mb-1">LLÁMANOS DIRECTAMENTE</div>
                  <div class="font-body-lg text-body-lg font-medium text-on-surface truncate">+34 600 00 00 00</div>
                </div>
              </a>
              <a class="btn-whatsapp w-full" href="https://wa.me/34600000000" target="_blank" rel="noopener noreferrer">
                <svg class="w-6 h-6 fill-current flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                <span>Contactar por WhatsApp</span>
              </a>
              <a class="btn-instagram w-full" href="https://www.instagram.com/quintana_maquinaria/" target="_blank" rel="noopener noreferrer">
                <svg class="w-6 h-6 fill-current flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                <span>Síguenos en Instagram</span>
              </a>
            </div>
          </div>
          <div class="mt-4">
            <h3 class="font-headline-md text-body-lg font-bold text-on-surface mb-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">location_on</span>
              Nuestra Base
            </h3>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
              Yecla, Región de Murcia. Prestando servicio al Altiplano, Alicante y Albacete.
            </p>
          </div>
        </div>
      </div>

      <!-- Column Right (Formulario) -->
      <div class="lg:col-span-7 flex flex-col">
        <div class="bg-surface border border-outline-variant/20 rounded-xl p-6 sm:p-8 md:p-10 sharp-shadow h-full relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-40 h-40 bg-surface-container-high rounded-full opacity-50 pointer-events-none"></div>
          <div class="relative z-10">
            <h2 class="font-headline-md text-headline-lg-mobile md:text-headline-md font-bold text-on-surface mb-2">
              Solicita Valoración Sin Compromiso
            </h2>
            <p class="font-body-md text-on-surface-variant mb-8 leading-relaxed">
              Rellena los detalles a continuación y te contactaremos en menos de 24 horas laborables.
            </p>
            <form class="flex flex-col gap-6" id="lead-form">
              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="sector">Sector de Actuación</label>
                <div class="relative">
                  <select class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface focus:ring-2 focus:ring-primary focus:border-primary appearance-none outline-none transition-all shadow-sm" id="sector" name="sector" required>
                    <option disabled selected value="">Selecciona un sector...</option>
                    <option value="agricola">Servicios Agrícolas</option>
                    <option value="civil">Obra Civil / Excavación</option>
                    <option value="otro">Otro</option>
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-outline">
                    <span class="material-symbols-outlined">expand_more</span>
                  </div>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                  <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="name">Tu Nombre o Empresa</label>
                  <input class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm" id="name" name="name" placeholder="Ej. Finca San José" type="text" required />
                </div>
                <div class="flex flex-col gap-2">
                  <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="phone">Teléfono de Contacto</label>
                  <input class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm" id="phone" name="phone" placeholder="+34 600 00 00 00" type="tel" required />
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="location">Población / Finca (Ubicación)</label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-4 text-outline/60 pointer-events-none">
                    <span class="material-symbols-outlined text-sm">pin_drop</span>
                  </div>
                  <input class="w-full bg-surface-bright border border-outline-variant rounded-lg pl-10 pr-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm" id="location" name="location" placeholder="Indica dónde se realizará el trabajo" type="text" required />
                </div>
              </div>
              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase" for="message">Cuéntanos qué necesitas (Breve)</label>
                <textarea class="w-full bg-surface-bright border border-outline-variant rounded-lg px-4 py-3 font-body-md text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all shadow-sm resize-none" id="message" name="message" placeholder="Desbroce de 20 hectáreas, zanjeo para tuberías..." rows="4" required></textarea>
              </div>
              <div class="mt-4">
                <button class="btn-agricola w-full py-4 text-base group cursor-pointer" type="submit">
                  <span>Enviar Solicitud</span>
                  <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </button>
                <p class="font-body-md text-xs text-outline text-center mt-4">
                  Al enviar este formulario, aceptas nuestra política de privacidad con respecto al tratamiento de datos.
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leaflet JS loaded synchronously as inline (before coverage logic) -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <!-- Coverage Logic (is:inline = not bundled, runs after Leaflet above) -->
  <script is:inline>
    const YECLA_LAT = 38.6136;
    const YECLA_LNG = -1.1166;
    const MAX_RADIUS_KM = 150;
    const COLOR_PRIMARY   = '#61993b';
    const COLOR_SECONDARY = '#b58753';

    function haversineKm(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLng/2)**2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    async function reverseGeocode(lat, lng) {
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`, { headers: {'Accept-Language':'es'} });
        const data = await res.json();
        const a = data.address;
        return a.city || a.town || a.village || a.municipality || a.county || 'Ubicación seleccionada';
      } catch { return 'Ubicación seleccionada'; }
    }

    async function forwardGeocode(query) {
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query+', España')}&limit=1`, { headers: {'Accept-Language':'es'} });
        const data = await res.json();
        if (data && data.length > 0) return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
        return null;
      } catch { return null; }
    }

    // Scripts is:inline at end of body run after DOM is parsed - no DOMContentLoaded needed
    (() => {
      const L = window.L;
      if (!L) { console.error('Leaflet no cargado'); return; }

      const map = L.map('coverage-map', { center:[YECLA_LAT, YECLA_LNG], zoom:7, scrollWheelZoom:false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution:'© <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>', maxZoom:18 }).addTo(map);

      L.circle([YECLA_LAT, YECLA_LNG], { radius: MAX_RADIUS_KM*1000, color: COLOR_PRIMARY, fillColor: COLOR_PRIMARY, fillOpacity:0.08, weight:2, dashArray:'6 4' }).addTo(map);

      const yeclaIcon = L.divIcon({
        html: `<div style="width:36px;height:36px;background:${COLOR_PRIMARY};border:3px solid white;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,0.3);"></div>`,
        className:'', iconAnchor:[18,36], popupAnchor:[0,-36]
      });
      L.marker([YECLA_LAT, YECLA_LNG], {icon:yeclaIcon}).addTo(map).bindPopup('<b>🚜 Base Quintanamur</b><br>Yecla, Murcia').openPopup();

      let userMarker = null;
      const userIcon = L.divIcon({
        html: `<div style="width:28px;height:28px;background:${COLOR_SECONDARY};border:3px solid white;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.35);display:flex;align-items:center;justify-content:center;font-size:13px;">📍</div>`,
        className:'', iconAnchor:[14,14], popupAnchor:[0,-18]
      });

      function showStatus(distKm, locationName) {
        const inside = distKm <= MAX_RADIUS_KM;
        const statusEl  = document.getElementById('coverage-status');
        const innerEl   = document.getElementById('coverage-inner');
        const iconEl    = document.getElementById('coverage-icon');
        const titleEl   = document.getElementById('coverage-title');
        const badgeEl   = document.getElementById('coverage-badge');
        const messageEl = document.getElementById('coverage-message');
        if (!statusEl) return;

        statusEl.classList.remove('hidden');
        innerEl.classList.remove('coverage-inside', 'coverage-outside');

        if (inside) {
          innerEl.classList.add('coverage-inside');
          iconEl.textContent     = '✓';
          titleEl.textContent    = `¡Zona de cobertura directa! (${Math.round(distKm)} km de Yecla)`;
          badgeEl.textContent    = 'ZONA PRIORITARIA';
          messageEl.innerHTML    = `<strong>${locationName}</strong> está dentro de nuestra zona de actuación directa. Desplazamiento ágil de maquinaria propia, respuesta en &lt;24h y sin sobrecostes logísticos.`;
        } else {
          innerEl.classList.add('coverage-outside');
          iconEl.textContent     = '🚜';
          titleEl.textContent    = `Tu proyecto está a ${Math.round(distKm)} km de nuestra base`;
          badgeEl.textContent    = 'GRAN PROYECTO';
          messageEl.innerHTML    = `Para trabajos de gran envergadura en <strong>${locationName}</strong>, desplazamos nuestra flota pesada y negociamos condiciones a medida. ¡Cuéntanos tu proyecto!`;
        }
        const locationInput = document.getElementById('location');
        if (locationInput && locationName && locationName !== 'Ubicación seleccionada') locationInput.value = locationName;
      }

      async function placeUserMarker(lat, lng) {
        if (userMarker) map.removeLayer(userMarker);
        userMarker = L.marker([lat, lng], {icon:userIcon, draggable:true}).addTo(map);
        const name = await reverseGeocode(lat, lng);
        const dist = haversineKm(YECLA_LAT, YECLA_LNG, lat, lng);
        userMarker.bindPopup(`<b>${name}</b><br>${Math.round(dist)} km de Yecla`).openPopup();
        userMarker.on('dragend', async (e) => {
          const pos = e.target.getLatLng();
          const n = await reverseGeocode(pos.lat, pos.lng);
          const d = haversineKm(YECLA_LAT, YECLA_LNG, pos.lat, pos.lng);
          userMarker.setPopupContent(`<b>${n}</b><br>${Math.round(d)} km de Yecla`).openPopup();
          showStatus(d, n);
        });
        showStatus(dist, name);
        map.setView([lat, lng], Math.max(map.getZoom(), 8), {animate:true});
      }

      map.on('click', (e) => placeUserMarker(e.latlng.lat, e.latlng.lng));

      const btnDetect = document.getElementById('btn-detect-location');
      if (btnDetect) {
        btnDetect.addEventListener('click', () => {
          if (!navigator.geolocation) { alert('Tu navegador no soporta geolocalización.'); return; }
          btnDetect.setAttribute('disabled','true');
          btnDetect.innerHTML = '<span class="material-symbols-outlined text-base" style="animation:spin 1s linear infinite;">sync</span><span>Detectando...</span>';
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              placeUserMarker(pos.coords.latitude, pos.coords.longitude);
              btnDetect.removeAttribute('disabled');
              btnDetect.innerHTML = '<span class="material-symbols-outlined text-base" style="font-variation-settings:\'FILL\' 1;">near_me</span><span>Detectar mi ubicación</span>';
            },
            () => {
              alert('No se pudo obtener tu ubicación. Haz clic en el mapa para seleccionarla manualmente.');
              btnDetect.removeAttribute('disabled');
              btnDetect.innerHTML = '<span class="material-symbols-outlined text-base" style="font-variation-settings:\'FILL\' 1;">near_me</span><span>Detectar mi ubicación</span>';
            },
            { enableHighAccuracy:true, timeout:8000 }
          );
        });
      }

      const searchInput = document.getElementById('map-search');
      if (searchInput) {
        searchInput.addEventListener('keydown', async (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            const query = searchInput.value.trim();
            if (!query) return;
            const result = await forwardGeocode(query);
            if (result) { placeUserMarker(result.lat, result.lng); }
            else { alert(`No se encontró "${query}". Prueba con otro nombre de municipio o haz clic en el mapa.`); }
          }
        });
      }
    })();
  </script>

  <!-- is:global so Astro doesn't scope selectors - Leaflet generates DOM dynamically
