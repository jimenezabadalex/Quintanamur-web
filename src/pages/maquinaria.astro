---
import Layout from "../layouts/Layout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { url } from "../utils/url";
---

<Layout
  title="Parque de Maquinaria y Flota Propia - Quintanamur S.L."
  description="Flota de tractores Fendt, retropala, trituradora forestal, fresadora de piedra y guiado GPS Topcon. Maquinaria pesada sin intermediarios en Yecla."
  activePage="maquinaria"
>
  <!-- Hero Section -->
  <header
    class="bg-inverse-surface text-on-primary py-24 md:py-32 px-margin-mobile md:px-margin-desktop relative overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat pointer-events-none"
      style={`background-image: url('${url("/images/maquinaria/hero-flota-bg.webp")}');`}
    >
      <!-- Gradient overlay: strong dark tone on text side, completely open on machinery side -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-inverse-surface via-inverse-surface/85 to-inverse-surface/40 md:to-transparent"
      >
      </div>
    </div>
    <div
      class="max-w-max-width mx-auto relative z-10 flex flex-col md:flex-row items-center"
    >
      <div class="w-full md:w-7/12 lg:w-1/2">
        <span
          class="font-label-caps text-label-caps text-secondary-fixed-dim uppercase tracking-widest block mb-4"
        >
          Parque de Maquinaria Propio
        </span>
        <h1
          class="font-display-lg text-headline-lg-mobile md:text-display-lg lg:text-[60px] font-extrabold mb-5 text-on-primary leading-tight"
        >
          NUESTRA FLOTA:<br />
          <span class="text-primary-fixed-dim"
            >MAQUINARIA PESADA Y TRACTORES FENDT</span
          >
        </h1>
        <p
          class="font-body-lg text-body-lg md:text-[19px] text-inverse-on-surface max-w-xl leading-relaxed mb-8"
        >
          Al servicio de la obra civil y las labores agrícolas más exigentes.
          Tecnología alemana Fendt y operarios con experiencia real en los
          terrenos más duros.
        </p>
        <div class="hidden md:block">
          <a href="#categoria-a" class="btn-agricola group">
            <span>VER FLOTA DE TRACTORES</span>
            <span
              class="material-symbols-outlined text-lg group-hover:translate-y-0.5 transition-transform"
              >arrow_downward</span
            >
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Quick-Jump Category Bar (Solo Móvil) -->
  <div
    class="sticky top-20 z-30 md:hidden bg-surface/95 backdrop-blur-md px-3 py-2.5"
  >
    <div class="grid grid-cols-3 gap-2 max-w-md mx-auto">
      <!-- Tractores (Verde Fendt) -->
      <a
        href="#categoria-a"
        class="flex flex-col items-center justify-center gap-1 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-primary/50 dark:border-primary/70 text-primary py-2 px-1 rounded-lg text-center shadow-[2px_2px_0px_#61993b] dark:shadow-[2px_2px_0px_#78b54e] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">agriculture</span>
        <span class="font-label-caps text-[11px] font-bold tracking-tight flex items-center gap-0.5">
          Tractores
          <span class="material-symbols-outlined text-[10px] opacity-70">arrow_downward</span>
        </span>
      </a>
      <!-- Retropala (Ocre / Marrón Tierra) -->
      <a
        href="#categoria-b"
        class="flex flex-col items-center justify-center gap-1 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-secondary/50 dark:border-secondary/70 text-secondary py-2 px-1 rounded-lg text-center shadow-[2px_2px_0px_#b58753] dark:shadow-[2px_2px_0px_#d4a36b] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">forklift</span>
        <span class="font-label-caps text-[11px] font-bold tracking-tight flex items-center gap-0.5">
          Retropala
          <span class="material-symbols-outlined text-[10px] opacity-70">arrow_downward</span>
        </span>
      </a>
      <!-- Aperos (Naranja Arcilla / Heavy Duty) -->
      <a
        href="#categoria-c"
        class="flex flex-col items-center justify-center gap-1 bg-surface-container-lowest dark:bg-surface-container-high border-2 border-tertiary/50 dark:border-tertiary/70 text-tertiary py-2 px-1 rounded-lg text-center shadow-[2px_2px_0px_#d96c21] dark:shadow-[2px_2px_0px_#fca465] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
      >
        <span class="material-symbols-outlined text-xl">build_circle</span>
        <span class="font-label-caps text-[11px] font-bold tracking-tight flex items-center gap-0.5">
          Aperos
          <span class="material-symbols-outlined text-[10px] opacity-70">arrow_downward</span>
        </span>
      </a>
    </div>
  </div>

  <!-- Strategic Advantage (Versatilidad Operativa - Solo Escritorio) -->
  <section
    class="hidden md:block py-16 md:py-20 px-margin-mobile md:px-margin-desktop bg-surface max-w-max-width mx-auto"
  >
    <div
      class="max-w-4xl mx-auto bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-8 md:p-12 sharp-shadow"
    >
      <div
        class="inline-flex items-center gap-2 mb-4 text-primary font-label-caps text-label-caps"
      >
        <span class="material-symbols-outlined text-base">verified</span>
        <span class="uppercase tracking-widest font-bold"
          >Ventaja Estratégica</span
        >
      </div>
      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6 border-l-4 border-primary pl-4 leading-tight"
      >
        VERSATILIDAD OPERATIVA: El secreto de nuestro rendimiento
      </h2>
      <p
        class="font-body-lg text-body-lg text-on-surface-variant mb-8 leading-relaxed"
      >
        Operamos con parque de maquinaria propio de primer nivel. Toda la
        maquinaria pesada y tractores de obra civil se emplea también en
        agricultura, garantizando máxima eficiencia y presupuestos competitivos
        sin intermediarios.
      </p>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-6 border-t border-outline-variant/20"
      >
        <div
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded-lg border border-outline-variant/20 min-w-0"
        >
          <span
            class="material-symbols-outlined text-primary text-xl flex-shrink-0"
            >precision_manufacturing</span
          >
          <span
            class="font-label-caps text-[12px] sm:text-[11px] font-bold text-on-surface"
            >Maquinaria Propia</span
          >
        </div>
        <div
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded-lg border border-outline-variant/20 min-w-0"
        >
          <span
            class="material-symbols-outlined text-primary text-xl flex-shrink-0"
            >engineering</span
          >
          <span
            class="font-label-caps text-[12px] sm:text-[11px] font-bold text-on-surface"
            >Operarios Expertos</span
          >
        </div>
        <div
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded-lg border border-outline-variant/20 min-w-0"
        >
          <span
            class="material-symbols-outlined text-primary text-xl flex-shrink-0"
            >sync_alt</span
          >
          <span
            class="font-label-caps text-[12px] sm:text-[11px] font-bold text-on-surface"
            >Dualidad Obra &amp; Campo</span
          >
        </div>
        <div
          class="flex items-center gap-3 p-3 bg-surface-container-low rounded-lg border border-outline-variant/20 min-w-0"
        >
          <span
            class="material-symbols-outlined text-primary text-xl flex-shrink-0"
            >handshake</span
          >
          <span
            class="font-label-caps text-[12px] sm:text-[11px] font-bold text-on-surface"
            >Sin Intermediarios</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- A. FUERZA MOTRIZ: TRACTORES -->
  <section
    id="categoria-a"
    class="py-16 bg-surface-container-low border-y border-outline-variant/30 scroll-mt-36"
  >
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div
        class="mb-12 flex flex-col sm:flex-row sm:items-end justify-between gap-4"
      >
        <div>
          <span
            class="font-label-caps text-label-caps text-secondary mb-2 block"
            >CATEGORÍA A</span
          >
          <h2
            class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface"
          >
            FUERZA MOTRIZ: TRACTORES
          </h2>
        </div>
        <div>
          <a href={url("/servicios")} class="btn-agricola group">
            <span>VER SERVICIOS</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Fendt 933 Vario -->
        <div
          class="bg-surface border border-outline-variant/20 rounded overflow-hidden flex flex-col sharp-shadow transition-transform sharp-shadow-hover"
        >
          <div
            class="aspect-[16/10] overflow-hidden relative bg-surface-container-lowest"
          >
            <img
              alt="Tractor Fendt 933 Vario de gran potencia para trituración y desbroce"
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              src={url("/images/maquinaria/tractor-fendt-933.webp")}
              loading="lazy"
            />
            <div
              class="absolute top-4 left-4 bg-primary text-on-primary px-3 py-1 font-label-caps text-label-caps rounded-xl shadow-sm"
            >
              FENDT 933 VARIO
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3
                class="font-headline-md text-[22px] font-bold text-on-surface mb-3"
              >
                Trituración y Desbroce Pesado
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
              >
                Máxima potencia para los trabajos más extremos. Tracción alemana
                equipada específicamente para arrastrar la fresadora <strong
                  class="text-on-surface">FI-IVAN</strong
                > y la desbrozadora forestal <strong class="text-on-surface"
                  >TMC Cancela</strong
                > en viales de obra y acondicionamiento rústico.
              </p>
            </div>
            <div
              class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-outline-variant/20"
            >
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                330 CV Potencia
              </span>
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                Fresadora FI-IVAN
              </span>
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                TFT Cancela
              </span>
            </div>
          </div>
        </div>

        <!-- Fendt 930 Vario -->
        <div
          class="bg-surface border border-outline-variant/20 rounded overflow-hidden flex flex-col sharp-shadow transition-transform sharp-shadow-hover"
        >
          <div
            class="aspect-[16/10] overflow-hidden relative bg-surface-container-lowest"
          >
            <img
              alt="Tractor Fendt 930 Vario realizando labores de desfonde profundo y molino"
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              src={url("/images/maquinaria/tractor-fendt-930.webp")}
              loading="lazy"
            />
            <div
              class="absolute top-4 left-4 bg-primary text-on-primary px-3 py-1 font-label-caps text-label-caps rounded-xl shadow-sm"
            >
              FENDT 930 VARIO
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3
                class="font-headline-md text-[22px] font-bold text-on-surface mb-3"
              >
                Molino, Topo y Desfonde Profundo
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
              >
                Fuerza de tiro constante en las profundidades del terreno.
                Especializado en el trabajo con <strong class="text-on-surface"
                  >molino de piedra</strong
                >, subsolador topo y arados de desfonde profundo para
                transformar fincas pedregosas en suelos productivos.
              </p>
            </div>
            <div
              class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-outline-variant/20"
            >
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                300 CV Potencia
              </span>
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                Desfonde Profundo
              </span>
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                Molino de Piedra
              </span>
            </div>
          </div>
        </div>

        <!-- Fendt 722 Vario -->
        <div
          class="bg-surface border border-outline-variant/20 rounded overflow-hidden flex flex-col sharp-shadow transition-transform sharp-shadow-hover"
        >
          <div
            class="aspect-[16/10] overflow-hidden relative bg-surface-container-lowest"
          >
            <img
              alt="Tractor Fendt 722 Vario con guiado satelital GPS para plantaciones"
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              src={url("/images/maquinaria/tractor-fendt-722.webp")}
              loading="lazy"
            />
            <div
              class="absolute top-4 left-4 bg-primary text-on-primary px-3 py-1 font-label-caps text-label-caps rounded-xl shadow-sm"
            >
              FENDT 722 VARIO
            </div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <h3
                class="font-headline-md text-[22px] font-bold text-on-surface mb-3"
              >
                Plantación de Precisión GPS Topcon
              </h3>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
              >
                Agilidad y tecnología satelital centimétrica. Acoplado a la
                máquina plantadora automatizada con guiado <strong
                  class="text-on-surface">GPS Topcon RTK</strong
                > para plantaciones de viña, olivar intensivo, almendros y frutales
                con alineación impecable.
              </p>
            </div>
            <div
              class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-outline-variant/20"
            >
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                220 CV Potencia
              </span>
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                GPS Topcon RTK
              </span>
              <span
                class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
              >
                Viña / Olivo / Almendro
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Fendt 211 Vario: Unidad Especialista a Demanda -->
      <div
        class="mt-8 bg-surface border border-secondary/30 rounded-lg overflow-hidden sharp-shadow hover:sharp-shadow-hover transition-all grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center"
      >
        <div
          class="lg:col-span-5 aspect-[16/10] lg:aspect-auto lg:h-full bg-surface-container-lowest overflow-hidden relative min-h-[220px]"
        >
          <img
            alt="Tractor Fendt 211 Vario especialista en hilerado de piedras"
            class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
            src={url("/images/maquinaria/tractor-fendt-211.webp")}
            loading="lazy"
          />
          <div
            class="absolute top-4 left-4 bg-secondary text-on-secondary px-3 py-1 font-label-caps text-label-caps rounded-xl shadow-sm"
          >
            FENDT 211 VARIO
          </div>
        </div>
        <div
          class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between h-full"
        >
          <div>
            <div
              class="inline-flex items-center gap-2 mb-3 text-secondary font-label-caps text-label-caps font-bold"
            >
              <span class="material-symbols-outlined text-base">stars</span>
              <span>UNIDAD ESPECIALISTA A DEMANDA</span>
            </div>
            <h3
              class="font-headline-md text-[22px] md:text-[26px] font-bold text-on-surface mb-3"
            >
              Servicio Exclusivo de Hilerado de Piedras
            </h3>
            <p
              class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed"
            >
              Tractor compacto y ágil de perfil estrecho. Especializado en
              labores de <strong class="text-on-surface"
                >hilerado y acumulación de piedra superficial</strong
              > en cualquier marco de plantación, preparando el terreno para su trituración
              o recogida.
            </p>
          </div>
          <div
            class="flex flex-wrap gap-2 pt-4 border-t border-outline-variant/20"
          >
            <span
              class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
            >
              110 CV Potencia
            </span>
            <span
              class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
            >
              Hilerador de Piedras
            </span>
            <span
              class="px-2 py-1 bg-surface-container text-on-surface-variant font-label-caps text-[10px] rounded border border-outline-variant/30"
            >
              Maniobrabilidad Extrema
            </span>
            <span
              class="px-2 py-1 bg-secondary/10 text-secondary font-label-caps text-[10px] rounded border border-secondary/30 font-bold"
            >
              Servicio Específico
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- B. MOVIMIENTO DE TIERRAS -->
  <section
    id="categoria-b"
    class="py-16 md:py-24 px-margin-mobile md:px-margin-desktop bg-surface max-w-max-width mx-auto scroll-mt-36"
  >
    <div
      class="mb-12 flex flex-col sm:flex-row sm:items-end justify-between gap-4"
    >
      <div>
        <span class="font-label-caps text-label-caps text-secondary mb-2 block"
          >CATEGORÍA B</span
        >
        <h2
          class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface"
        >
          MOVIMIENTO DE TIERRAS
        </h2>
      </div>
      <div>
        <a href={url("/servicios")} class="btn-agricola group">
          <span>VER SERVICIOS</span>
          <span
            class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
            >arrow_forward</span
          >
        </a>
      </div>
    </div>
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-gutter bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden sharp-shadow"
    >
      <div
        class="lg:col-span-7 bg-surface-container-lowest flex items-center justify-center p-6 sm:p-8 lg:p-10 relative overflow-hidden min-h-[300px] lg:min-h-[440px]"
      >
        <img
          alt="Retropala mixta Caterpillar 432 para excavaciones y apertura de zanjas"
          class="w-full h-full max-h-[420px] object-contain mix-blend-multiply hover:scale-105 transition-transform duration-500"
          src={url("/images/maquinaria/retropala-trinity.webp")}
          loading="lazy"
        />
      </div>
      <div
        class="lg:col-span-5 p-8 lg:p-12 flex flex-col justify-center bg-surface-container-lowest border-t lg:border-t-0 lg:border-l border-outline-variant/20"
      >
        <div
          class="inline-flex items-center gap-2 text-primary font-label-caps text-label-caps mb-4"
        >
          <span class="material-symbols-outlined text-xl">forklift</span>
          EQUIPO DESTACADO
        </div>
        <h3
          class="font-display-lg text-[32px] md:text-[40px] leading-tight text-on-surface mb-6"
        >
          Retropala Mixta: El comodín perfecto
        </h3>
        <div class="space-y-6">
          <div>
            <h4 class="font-label-caps text-label-caps text-secondary mb-2">
              OBRA CIVIL
            </h4>
            <p
              class="font-body-md text-body-md text-on-surface-variant leading-relaxed"
            >
              Excavación de zanjas, cimentaciones, perfilado de taludes y
              demoliciones mediante martillo rompedor.
            </p>
          </div>
          <div>
            <h4 class="font-label-caps text-label-caps text-secondary mb-2">
              AGRICULTURA
            </h4>
            <p
              class="font-body-md text-body-md text-on-surface-variant leading-relaxed"
            >
              Apertura de zanjas para la instalación de riego, uso de la pala
              delantera para carga y movimiento de tierras
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- C. IMPLEMENTOS DUALES -->
  <section
    id="categoria-c"
    class="py-16 md:py-24 bg-surface-dim border-t border-outline-variant/20 scroll-mt-36"
  >
    <div class="max-w-max-width mx-auto px-margin-mobile md:px-margin-desktop">
      <div
        class="mb-12 flex flex-col sm:flex-row sm:items-end justify-between gap-4"
      >
        <div>
          <span
            class="font-label-caps text-label-caps text-secondary mb-2 block"
            >CATEGORÍA C</span
          >
          <h2
            class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-2"
          >
            APEROS Y TECNOLOGÍA DE PRECISIÓN
          </h2>
          <p
            class="font-body-md text-body-md text-on-surface-variant max-w-xl leading-relaxed"
          >
            Equipos acoplados a nuestra maquinaria para ejecutar cada labor con
            exactitud: trituración de piedra, desbroce y plantación por
            satélite.
          </p>
        </div>
        <div>
          <a href={url("/servicios")} class="btn-agricola group">
            <span>VER SERVICIOS</span>
            <span
              class="material-symbols-outlined text-base group-hover:translate-x-0.5 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>
      </div>

