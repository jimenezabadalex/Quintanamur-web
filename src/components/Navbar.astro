---
import { url } from '../utils/url';

interface Props {
  activePage?: 'inicio' | 'maquinaria' | 'servicios' | 'sobre-nosotros' | 'contacto' | string;
}

const { activePage } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Inicio', href: url('/'), key: 'inicio' },
  { label: 'Maquinaria', href: url('/maquinaria'), key: 'maquinaria' },
  { label: 'Servicios', href: url('/servicios'), key: 'servicios' },
  { label: 'Sobre Nosotros', href: url('/sobre-nosotros'), key: 'sobre-nosotros' },
  { label: 'Contacto', href: url('/contacto'), key: 'contacto' },
];

const isCurrent = (key: string, href: string) => {
  if (activePage) return activePage === key;
  const homeUrl = url('/');
  if (href === homeUrl && (currentPath === homeUrl || currentPath === '' || currentPath === '/')) return true;
  return href !== homeUrl && currentPath.startsWith(href);
};
---

<header class="bg-secondary text-on-secondary shadow-md sticky top-0 z-50 transition-colors duration-200">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto h-20">
    <!-- Brand Logo -->
    <a class="text-headline-md font-headline-md font-bold text-on-secondary tracking-tight focus:outline-none focus:ring-2 focus:ring-secondary-fixed rounded" href={url('/')}>
      Quintanamur S.L.
    </a>

    <!-- Navigation Links (Desktop) -->
    <nav class="hidden md:flex gap-8 items-center" aria-label="Navegación principal">
      {navItems.map(item => {
        const active = isCurrent(item.key, item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'font-medium transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-secondary-fixed rounded px-1',
              active
                ? 'text-on-secondary font-bold border-b-2 border-on-secondary pb-1'
                : 'text-on-secondary/80 hover:text-on-secondary'
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Trailing Actions (Instagram + CTA) -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="https://www.instagram.com/quintanamur_sl/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-on-secondary flex items-center justify-center transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-secondary-fixed"
        aria-label="Síguenos en Instagram"
        title="Síguenos en Instagram @quintanamur_sl"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
      <a
        class="bg-tertiary text-on-tertiary px-6 py-3 rounded hover:bg-tertiary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider inline-block shadow-sm sharp-shadow focus:outline-none focus:ring-2 focus:ring-tertiary-fixed"
        href={url('/contacto')}
      >
        Solicitar Presupuesto
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden text-on-secondary p-2 rounded focus:outline-none focus:ring-2 focus:ring-secondary-fixed"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="material-symbols-outlined text-3xl" id="menu-icon">menu</span>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-secondary border-t border-secondary-fixed-dim/20 px-margin-mobile py-6 shadow-xl"
  >
    <nav class="flex flex-col gap-4" aria-label="Navegación móvil">
      {navItems.map(item => {
        const active = isCurrent(item.key, item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'py-2 px-3 rounded text-lg font-medium transition-colors duration-150',
              active
                ? 'bg-black/15 text-on-secondary font-bold border-l-4 border-primary-fixed'
                : 'text-on-secondary/90 hover:bg-black/10'
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
      
      <!-- Instagram Link in Mobile Menu -->
      <a
        href="https://www.instagram.com/quintanamur_sl/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 py-3 px-3 rounded text-on-secondary bg-white/10 hover:bg-white/20 transition-colors font-medium"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>Síguenos en Instagram</span>
      </a>

      <div class="pt-4 border-t border-secondary-fixed-dim/20">
        <a
          class="w-full text-center block bg-tertiary text-on-tertiary px-6 py-3 rounded hover:bg-tertiary-container transition-colors font-label-caps text-label-caps uppercase tracking-wider shadow-sm"
          href={url('/contacto')}
        >
          Solicitar Presupuesto
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  if (menuBtn && mobileMenu && menuIcon) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      menuIcon.textContent = isExpanded ? 'menu' : 'close';
    });
  }
</script>
