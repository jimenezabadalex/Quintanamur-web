---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<footer class={`bg-inverse-surface text-inverse-on-surface border-t border-outline-variant/20 py-12 px-margin-mobile md:px-margin-desktop mt-auto ${className}`}>
  <div class="max-w-max-width mx-auto flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="text-center md:text-left">
      <a href="/" class="text-headline-md font-headline-md font-bold text-primary-fixed block mb-2 focus:outline-none focus:ring-2 focus:ring-primary-fixed rounded">
        Quintanamur S.L.
      </a>
      <p class="font-body-md text-body-md text-surface-container-high text-sm">
        © 2026 Quintanamur S.L. Ingeniería Civil y Agraria de Precisión.
      </p>
    </div>

    <!-- Social Media Link (Instagram) -->
    <div class="flex items-center gap-3">
      <a
        href="https://www.instagram.com/quintana_maquinaria/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/5 hover:bg-white/10 text-on-surface border border-outline-variant/30 text-sm font-medium transition-all hover:scale-105 group"
      >
        <svg class="w-5 h-5 fill-current text-primary-fixed group-hover:text-primary transition-colors" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span class="text-surface-bright font-semibold">@quintana_maquinaria</span>
      </a>
    </div>

    <nav class="flex flex-wrap justify-center gap-6 font-label-caps text-label-caps text-surface-variant" aria-label="Enlaces legales">
      <a class="hover:text-primary-fixed-dim transition-colors" href="#">Aviso Legal</a>
      <a class="hover:text-primary-fixed-dim transition-colors" href="#">Política de Privacidad</a>
      <a class="hover:text-primary-fixed-dim transition-colors" href="#">Sostenibilidad</a>
      <a class="hover:text-primary-fixed-dim transition-colors" href="#">Soporte Técnico</a>
    </nav>
  </div>
</footer>
